<Window x:Class="WorkHub.App.Views.ManageTagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WorkHub.Presentation.ViewModels;assembly=WorkHub.Presentation"
        xmlns:views="clr-namespace:WorkHub.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ManageTagsViewModel}"
        Title="{Binding Title}"
        Width="600" Height="720" MinWidth="380" MinHeight="520" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Surface}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=FilterBox}">
    <!-- Phase 21: Close is the default and the cancel button (Enter and Esc never write). Enter in the name box only previews.
         Phase 22: in Delete everywhere… Enter on the focused Confirm is swallowed (ConfirmButton_PreviewKeyDown); Space on the focused,
         enabled Confirm is the deliberate keyboard confirmation. Rename/Merge keyboard behaviour is unchanged.
         Phase 24: Projects with this tag (read only). Enter / double-click on a row of THAT list only = Show in Workspace
         (ProjectsList_PreviewKeyDown, ProjectsList_MouseDoubleClick); Enter elsewhere keeps its Phase 21/22 meaning. -->
    <Window.Resources>
        <views:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </Window.Resources>
    <DockPanel Margin="20,12,20,16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" AutomationProperties.AutomationId="ManageTagsHint"
                   Text="Rename a tag, merge it into another tag, or delete it, in every project that is not in the Trash. Projects in the Trash keep their tags." />
        <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Filter" />
            <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter tags" AutomationProperties.AutomationId="ManageTagsFilter" />
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button Content="Cancel change" HorizontalAlignment="Left" Command="{Binding CancelChangeCommand}" AutomationProperties.AutomationId="ManageTagsCancelChange" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" IsCancel="True" IsDefault="True" Command="{Binding CloseCommand}" AutomationProperties.AutomationId="ManageTagsClose" />
                <Button x:Name="ConfirmButton" Content="Confirm" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmCommand}"
                        PreviewKeyDown="ConfirmButton_PreviewKeyDown"
                        AutomationProperties.Name="Confirm tag change" AutomationProperties.AutomationId="ManageTagsConfirm" />
            </StackPanel>
        </Grid>

        <!-- Phase 24: below the actions (D3: always visible for the selected tag row). -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Projects with this tag" />
                    <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Text="{Binding TaggedProjectsHeader}"
                               AutomationProperties.AutomationId="ManageTagsProjectsHeader"
                               Visibility="{Binding TaggedProjectsHeader, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
                <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom" Content="Show in Workspace" Command="{Binding ShowInWorkspaceCommand}"
                        AutomationProperties.AutomationId="ManageTagsShowInWorkspace" />
            </Grid>
            <TextBlock DockPanel.Dock="Top" Margin="0,6,0,0" Style="{StaticResource FieldError}" TextWrapping="Wrap" Text="{Binding TaggedProjectsError}"
                       AutomationProperties.AutomationId="ManageTagsProjectsError"
                       Visibility="{Binding TaggedProjectsError, Converter={StaticResource NullToCollapsed}}" />
            <ListBox x:Name="ProjectsList" Margin="0,6,0,0" Height="150" ItemsSource="{Binding TaggedProjects}" SelectedItem="{Binding SelectedTaggedProject}"
                     SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewKeyDown="ProjectsList_PreviewKeyDown" MouseDoubleClick="ProjectsList_MouseDoubleClick"
                     AutomationProperties.Name="Projects with this tag" AutomationProperties.AutomationId="ManageTagsProjects">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TaggedProjectRowViewModel}">
                        <Grid Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource FieldHint}" Text="{Binding PathText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FieldHint}" Text="{Binding SpellingText}"
                                           Visibility="{Binding SpellingText, Converter={StaticResource NullToCollapsed}}" />
                                <TextBlock Style="{StaticResource FieldHint}" Margin="8,0,0,0" Text="{Binding StateText}"
                                           Visibility="{Binding StateText, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Rename…" Command="{Binding StartRenameCommand}" AutomationProperties.AutomationId="ManageTagsRename" />
                <Button Content="Merge into…" Margin="8,0,0,0" Command="{Binding StartMergeCommand}" AutomationProperties.AutomationId="ManageTagsMerge" />
                <Button Content="Delete everywhere…" Margin="8,0,0,0" Command="{Binding StartDeleteCommand}" AutomationProperties.AutomationId="ManageTagsDelete" />
            </StackPanel>
            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsDeleteMode, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Delete the selected tag from every project that is not in the Trash. Preview first." />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="Preview" Command="{Binding PreviewCommand}" AutomationProperties.AutomationId="ManageTagsPreviewDelete" />
                </Grid>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding DeletePreviewText}" AutomationProperties.AutomationId="ManageTagsDeletePreview"
                           Visibility="{Binding DeletePreviewText, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsRenameMode, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="New name" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewNameBox" MaxLength="200" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="New tag name" AutomationProperties.AutomationId="ManageTagsNewName">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding PreviewCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="Preview" Command="{Binding PreviewCommand}" AutomationProperties.AutomationId="ManageTagsPreviewRename" />
                </Grid>
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding NameError}" AutomationProperties.AutomationId="ManageTagsNameError" />
            </StackPanel>
            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsMergeMode, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Merge into" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding MergeTargets}" SelectedItem="{Binding MergeTarget}" DisplayMemberPath="Spelling"
                              AutomationProperties.Name="Merge into tag" AutomationProperties.AutomationId="ManageTagsMergeTarget" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="Preview" Command="{Binding PreviewCommand}" AutomationProperties.AutomationId="ManageTagsPreviewMerge" />
                </Grid>
            </StackPanel>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding PreviewText}" AutomationProperties.AutomationId="ManageTagsPreview"
                       Visibility="{Binding PreviewText, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource FieldHint}" TextWrapping="Wrap" Text="{Binding Message}" AutomationProperties.AutomationId="ManageTagsMessage"
                       Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <ListBox x:Name="TagList" Margin="0,12,0,0" ItemsSource="{Binding FilteredRows}" SelectedItem="{Binding SelectedRow}" SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Tags in use" AutomationProperties.AutomationId="ManageTagsList">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TagRowViewModel}">
                    <Grid Margin="2,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Spelling}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <TextBlock Style="{StaticResource FieldHint}" Text="{Binding CountText}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="8,0,0,0" Text="{Binding TrashText}"
                                       Visibility="{Binding TrashText, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Spelling}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</Window>
