<Window x:Class="WorkHub.App.Views.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WorkHub.Presentation.ViewModels;assembly=WorkHub.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:NoteEditorViewModel}"
        Title="{Binding WindowTitle}"
        Width="720" Height="560" MinWidth="460" MinHeight="360" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Surface}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </Window.InputBindings>
    <DockPanel Margin="20,12,20,16">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource FieldError}" FontSize="12" TextWrapping="Wrap" Text="{Binding GeneralError}"
                       AutomationProperties.AutomationId="NoteGeneralError" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding CanRecover, Converter={StaticResource BoolToVisibility}}">
                <Button Content="Copy draft" Command="{Binding CopyDraftCommand}" AutomationProperties.Name="Copy draft" />
                <Button Margin="8,0,0,0" Content="Save as new note" Command="{Binding SaveAsNewCommand}" AutomationProperties.Name="Save as new note" />
            </StackPanel>
            <DockPanel Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Close" IsCancel="True" Command="{Binding RequestCloseCommand}" AutomationProperties.Name="Close" />
                    <Button Content="Save" IsDefault="False" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                            ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldHint}" Text="{Binding StatusText}" AutomationProperties.AutomationId="NoteStatus" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldHint}" Text="Saving… this window stays open until the change is stored."
                           Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="SavingHint" />
            </DockPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,4" Text="{Binding LocationText}" TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Title" />
            <TextBox x:Name="TitleBox" MaxLength="200" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}" AutomationProperties.Name="Title" />
            <TextBlock Style="{StaticResource FieldError}" Text="{Binding TitleError}" AutomationProperties.AutomationId="TitleError" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Content" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource FieldError}" Text="{Binding ContentError}" AutomationProperties.AutomationId="ContentError" />
        <TextBox x:Name="ContentBox" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Content" />
    </DockPanel>
</Window>
