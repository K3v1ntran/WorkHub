<Window x:Class="WorkHub.App.Views.RestoreBackupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WorkHub.App.Views"
        Title="Restore from a backup"
        Width="760" Height="560" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Surface}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <!-- Phase 10: the Failed shell's entry to Restore (Settings is not reachable when startup failed). -->
    <DockPanel Margin="16,8,16,12">
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,0,0" Content="Close" IsCancel="True" Click="Close_Click" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <views:BackupsPanel />
        </ScrollViewer>
    </DockPanel>
</Window>
