<Window x:Class="WorkHub.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WorkHub.Presentation.ViewModels;assembly=WorkHub.Presentation"
        xmlns:settings="clr-namespace:WorkHub.Core.Settings;assembly=WorkHub.Core"
        xmlns:repo="clr-namespace:WorkHub.Core.Repositories;assembly=WorkHub.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Settings"
        Width="820" Height="640" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Surface}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border}" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
                    <Button Content="Save" IsDefault="True" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldError}" FontSize="12" Text="{Binding SaveError}" />
            </DockPanel>
        </Border>

        <!-- Navigation: REPOSITORY (SVN, Git) and DATA (legacy import, backups). Group headers are not selectable. -->
        <Border DockPanel.Dock="Left" Width="190" Background="{StaticResource Brush.Background}"
                BorderThickness="0,0,1,0" BorderBrush="{StaticResource Brush.Border}">
            <Border.Resources>
                <CollectionViewSource x:Key="GroupedPages" Source="{Binding Pages}">
                    <CollectionViewSource.GroupDescriptions>
                        <PropertyGroupDescription PropertyName="Group" />
                    </CollectionViewSource.GroupDescriptions>
                </CollectionViewSource>
            </Border.Resources>
            <ListBox BorderThickness="0" Background="Transparent" AutomationProperties.Name="Settings pages"
                     ItemsSource="{Binding Source={StaticResource GroupedPages}}" SelectedItem="{Binding SelectedPage}">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding Name}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsPageItem}">
                        <TextBlock Margin="10,4" Text="{Binding Title}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,4,20,16">
            <StackPanel>
                <!-- SVN page -->
                <StackPanel Visibility="{Binding IsSvnSelected, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="0,10,0,0" FontSize="16" FontWeight="SemiBold" Text="SVN" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="Used by SVN SYSTEM, SVN ORACLE and RELEASE. Repositories open in the TortoiseSVN repository browser." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="SVN host" />
                    <TextBox Text="{Binding SvnHost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SVN host" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="Base URL, for example https://svn.example.test/svn/" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="SVN SYSTEM prefix" />
                            <TextBox FontFamily="Consolas" Text="{Binding SvnSystemPrefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SVN SYSTEM prefix" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="SVN ORACLE prefix" />
                            <TextBox FontFamily="Consolas" Text="{Binding SvnOraclePrefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SVN ORACLE prefix" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="RELEASE prefix" />
                            <TextBox FontFamily="Consolas" Text="{Binding ReleasePrefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="RELEASE prefix" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="TortoiseProc.exe" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Detect" Command="{Binding DetectTortoiseCommand}" />
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Browse…" Command="{Binding BrowseTortoiseCommand}" />
                        <TextBox Text="{Binding TortoiseProcPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="TortoiseProc.exe path" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource FieldHint}" Text="Full path to TortoiseProc.exe on this machine. Detect only checks the standard install folder." />
                </StackPanel>

                <!-- Git page -->
                <StackPanel Visibility="{Binding IsGitSelected, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="0,10,0,0" FontSize="16" FontWeight="SemiBold" Text="Git" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="Used by GIT SYSTEM and GIT ORACLE. Repositories open in the default browser." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="GitBucket host" />
                    <TextBox Text="{Binding GitHost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="GitBucket host" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="Base URL, for example https://git.example.test/gitbucket/root/" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="GIT SYSTEM prefix" />
                            <TextBox FontFamily="Consolas" Text="{Binding GitSystemPrefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="GIT SYSTEM prefix" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="GIT ORACLE prefix" />
                            <TextBox FontFamily="Consolas" Text="{Binding GitOraclePrefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="GIT ORACLE prefix" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Data page: Import Legacy WorkHub XML (writes immediately; independent of Save/Cancel). -->
                <StackPanel DataContext="{Binding LegacyImport}"
                            Visibility="{Binding DataContext.IsLegacyImportSelected, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="0,10,0,0" FontSize="16" FontWeight="SemiBold" Text="Import Legacy WorkHub XML" />
                    <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                               Text="One-time import of System master data (SystemCode, SystemName) from an old WorkHub HubData XML file. SYSTEM entries join SVN SYSTEM, GIT SYSTEM and RELEASE; ORACLE entries join SVN ORACLE and GIT ORACLE. Hosts, prefixes and other settings are not imported. Existing names, disabled memberships and custom targets are never changed." />
                    <TextBlock Style="{StaticResource FieldHint}" Foreground="{StaticResource Brush.Warning}"
                               Text="Import writes to the database immediately; it is not undone by Cancel." />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Choose XML file…" Command="{Binding ChooseFileCommand}" AutomationProperties.Name="Choose legacy XML" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}" Text="Working…"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource FieldHint}" AutomationProperties.AutomationId="LegacyImportInProgress"
                               Text="Importing… Settings stays open until the import has finished."
                               Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Margin="0,10,0,0" Style="{StaticResource FieldError}" FontSize="12" Text="{Binding Error}" AutomationProperties.AutomationId="LegacyImportError" />
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding ResultMessage}" AutomationProperties.AutomationId="LegacyImportResult">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Read-only preview -->
                    <Border Margin="0,12,0,0" Padding="12" CornerRadius="4" Background="{StaticResource Brush.Background}"
                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding SourceName, StringFormat=Source: {0}}" AutomationProperties.AutomationId="LegacySource" />
                            <Grid Margin="0,8,0,0" AutomationProperties.AutomationId="LegacyPreviewCounts">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="SYSTEM entries" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Plan.SystemEntries}" AutomationProperties.AutomationId="CountSystemEntries" />
                                <TextBlock Grid.Row="1" Text="ORACLE entries" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Plan.OracleEntries}" AutomationProperties.AutomationId="CountOracleEntries" />
                                <TextBlock Grid.Row="2" Margin="0,6,0,0" Text="New Systems" /><TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Text="{Binding Plan.NewSystems}" AutomationProperties.AutomationId="CountNewSystems" />
                                <TextBlock Grid.Row="3" Text="Existing Systems" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Plan.ExistingSystems}" AutomationProperties.AutomationId="CountExistingSystems" />
                                <TextBlock Grid.Row="4" Text="New Memberships" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Plan.NewMemberships}" AutomationProperties.AutomationId="CountNewMemberships" />
                                <TextBlock Grid.Row="5" Text="Existing Memberships" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Plan.ExistingMemberships}" AutomationProperties.AutomationId="CountExistingMemberships" />
                                <TextBlock Grid.Row="6" Text="  of which disabled (kept)" Foreground="{StaticResource Brush.MutedText}" /><TextBlock Grid.Row="6" Grid.Column="1" Foreground="{StaticResource Brush.MutedText}" Text="{Binding Plan.DisabledMembershipsKept}" AutomationProperties.AutomationId="CountDisabledKept" />
                                <TextBlock Grid.Row="7" Text="Conflicts" /><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Plan.Conflicts.Count}" AutomationProperties.AutomationId="CountConflicts" />
                                <TextBlock Grid.Row="8" Text="Invalid Entries" /><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Plan.InvalidEntries.Count}" AutomationProperties.AutomationId="CountInvalid" />
                            </Grid>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Brush.MutedText}" Text="{Binding NothingToImportMessage}" />

                            <StackPanel Margin="0,10,0,0" Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Brush.Warning}" Text="Conflicts (skipped; current data is kept)" />
                                <ItemsControl ItemsSource="{Binding Conflicts}" Focusable="False" AutomationProperties.Name="Legacy conflicts">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LegacyConflictRow}">
                                            <StackPanel Margin="0,4,0,0">
                                                <TextBlock FontFamily="Consolas" Text="{Binding SystemCode}" />
                                                <TextBlock FontSize="11" Text="{Binding CurrentName, StringFormat=Current: {0}}" />
                                                <TextBlock FontSize="11" Text="{Binding LegacyName, StringFormat=Legacy: {0}}" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource Brush.MutedText}" TextWrapping="Wrap" Text="{Binding Reason, StringFormat=Reason: {0}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0" Visibility="{Binding HasInvalidEntries, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Brush.Error}" Text="Invalid entries (not imported)" />
                                <ItemsControl ItemsSource="{Binding InvalidEntries}" Focusable="False" AutomationProperties.Name="Legacy invalid entries">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LegacyInvalidRow}">
                                            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" FontSize="11">
                                                <Run Text="{Binding Section, Mode=OneWay}" FontWeight="SemiBold" /> · <Run Text="{Binding SystemCode, Mode=OneWay}" FontFamily="Consolas" /> · <Run Text="{Binding SystemName, Mode=OneWay}" /> — <Run Text="{Binding Reason, Mode=OneWay}" Foreground="{StaticResource Brush.Error}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Command="{Binding ClearCommand}" AutomationProperties.Name="Cancel import" />
                                <Button Content="Import" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}" AutomationProperties.Name="Import" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Data page: Backups (read-only; Phase 9). No command here can restore, replace or delete anything. -->
                <StackPanel DataContext="{Binding Backups}"
                            Visibility="{Binding DataContext.IsBackupsSelected, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="0,10,0,0" FontSize="16" FontWeight="SemiBold" Text="Database backups" />
                    <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Text="{x:Static vm:BackupsViewModel.ScopeText}" AutomationProperties.AutomationId="BackupsScope" />
                    <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Text="{x:Static vm:BackupsViewModel.RetentionText}" />
                    <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}" Text="{x:Static vm:BackupsViewModel.RecoveryText}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh backups" />
                        <Button Margin="8,0,0,0" Content="Validate" Command="{Binding ValidateCommand}" AutomationProperties.Name="Validate selected backup"
                                ToolTip="Full check of the selected backup: integrity, foreign keys and schema structure. Read-only." />
                        <Button Margin="8,0,0,0" Content="Open Backups folder" Command="{Binding OpenFolderCommand}" AutomationProperties.Name="Open Backups folder" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}" Text="Loading…"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource FieldError}" FontSize="12" TextWrapping="Wrap" Text="{Binding Error}" AutomationProperties.AutomationId="BackupsError" />
                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Brush.MutedText}" Text="No backups yet."
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                    <ListBox Margin="0,8,0,0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutomationProperties.Name="Backups"
                             BorderThickness="1" BorderBrush="{StaticResource Brush.Border}" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BackupRowViewModel}">
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding KindText}" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource Brush.MutedText}" Text="{Binding TakenText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding FileName}" ToolTip="{Binding FileName}" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource Brush.MutedText}" Text="{Binding CompatibilityText}" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource Brush.MutedText}" TextWrapping="Wrap" Text="{Binding DetailText}"
                                                   Visibility="{Binding IsProblem, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock x:Name="Status" HorizontalAlignment="Right" Text="{Binding StatusText}" />
                                        <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Brush.MutedText}" Text="{Binding SizeText}" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                        <Setter TargetName="Status" Property="Foreground" Value="{StaticResource Brush.Error}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFullyValidated}" Value="True">
                                        <Setter TargetName="Status" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Repository pages only: validation and generated target preview -->
                <StackPanel Visibility="{Binding IsRepositoryPageSelected, Converter={StaticResource BoolToVisibility}}">
                <!-- Validation -->
                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Issues}" Focusable="False"
                              Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type settings:SettingsIssue}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="12" Text="&#xE7BA;" Foreground="{StaticResource Brush.Warning}" />
                                <TextBlock x:Name="Message" Margin="6,0,0,0" TextWrapping="Wrap" Text="{Binding Message}" Foreground="{StaticResource Brush.Warning}" />
                                <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="{StaticResource Brush.MutedText}" Text="{Binding Section, StringFormat=({0})}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static settings:IssueSeverity.Error}">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xEA39;" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Error}" />
                                    <Setter TargetName="Message" Property="Foreground" Value="{StaticResource Brush.Error}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Preview: same resolver as opening repositories. -->
                <Border Margin="0,16,0,0" Padding="12" CornerRadius="4" Background="{StaticResource Brush.Background}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Generated target preview" />
                            <TextBox DockPanel.Dock="Right" Width="140" HorizontalAlignment="Right" FontFamily="Consolas"
                                     Text="{Binding SampleCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sample system code" />
                            <TextBlock DockPanel.Dock="Right" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.MutedText}" Text="Sample System Code" />
                        </DockPanel>
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Preview}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TargetPreviewRow}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                        <TextBlock x:Name="Value" Grid.Column="1" FontFamily="Consolas" TextWrapping="Wrap" Text="{Binding Text}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                            <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Brush.MutedText}" />
                                            <Setter TargetName="Value" Property="FontFamily" Value="Segoe UI" />
                                            <Setter TargetName="Value" Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
