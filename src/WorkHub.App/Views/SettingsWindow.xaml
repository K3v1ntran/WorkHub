<Window x:Class="WorkHub.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WorkHub.Presentation.ViewModels;assembly=WorkHub.Presentation"
        xmlns:settings="clr-namespace:WorkHub.Core.Settings;assembly=WorkHub.Core"
        xmlns:repo="clr-namespace:WorkHub.Core.Repositories;assembly=WorkHub.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Settings"
        Width="820" Height="640" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Surface}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border}" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
                    <Button Content="Save" IsDefault="True" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldError}" FontSize="12" Text="{Binding SaveError}" />
            </DockPanel>
        </Border>

        <!-- Navigation: Settings > Repository > SVN / Git -->
        <Border DockPanel.Dock="Left" Width="170" Background="{StaticResource Brush.Background}"
                BorderThickness="0,0,1,0" BorderBrush="{StaticResource Brush.Border}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="REPOSITORY" />
                <ListBox BorderThickness="0" Background="Transparent" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="Label" Margin="10,4" Text="SVN" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Static repo:SettingsSection.Git}">
                                    <Setter TargetName="Label" Property="Text" Value="Git" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,4,20,16">
            <StackPanel>
                <!-- SVN page -->
                <StackPanel Visibility="{Binding IsSvnSelected, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="0,10,0,0" FontSize="16" FontWeight="SemiBold" Text="SVN" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="Used by SVN SYSTEM, SVN ORACLE and RELEASE. Repositories open in the TortoiseSVN repository browser." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="SVN host" />
                    <TextBox Text="{Binding SvnHost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SVN host" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="Base URL, for example https://svn.example.test/svn/" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="SVN SYSTEM prefix" />
                            <TextBox FontFamily="Consolas" Text="{Binding SvnSystemPrefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SVN SYSTEM prefix" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="SVN ORACLE prefix" />
                            <TextBox FontFamily="Consolas" Text="{Binding SvnOraclePrefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SVN ORACLE prefix" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="RELEASE prefix" />
                            <TextBox FontFamily="Consolas" Text="{Binding ReleasePrefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="RELEASE prefix" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="TortoiseProc.exe" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Detect" Command="{Binding DetectTortoiseCommand}" />
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Browse…" Command="{Binding BrowseTortoiseCommand}" />
                        <TextBox Text="{Binding TortoiseProcPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="TortoiseProc.exe path" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource FieldHint}" Text="Full path to TortoiseProc.exe on this machine. Detect only checks the standard install folder." />
                </StackPanel>

                <!-- Git page -->
                <StackPanel Visibility="{Binding IsGitSelected, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="0,10,0,0" FontSize="16" FontWeight="SemiBold" Text="Git" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="Used by GIT SYSTEM and GIT ORACLE. Repositories open in the default browser." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="GitBucket host" />
                    <TextBox Text="{Binding GitHost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="GitBucket host" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="Base URL, for example https://git.example.test/gitbucket/root/" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="GIT SYSTEM prefix" />
                            <TextBox FontFamily="Consolas" Text="{Binding GitSystemPrefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="GIT SYSTEM prefix" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="GIT ORACLE prefix" />
                            <TextBox FontFamily="Consolas" Text="{Binding GitOraclePrefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="GIT ORACLE prefix" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Validation -->
                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Issues}" Focusable="False"
                              Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type settings:SettingsIssue}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="12" Text="&#xE7BA;" Foreground="{StaticResource Brush.Warning}" />
                                <TextBlock x:Name="Message" Margin="6,0,0,0" TextWrapping="Wrap" Text="{Binding Message}" Foreground="{StaticResource Brush.Warning}" />
                                <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="{StaticResource Brush.MutedText}" Text="{Binding Section, StringFormat=({0})}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static settings:IssueSeverity.Error}">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xEA39;" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Error}" />
                                    <Setter TargetName="Message" Property="Foreground" Value="{StaticResource Brush.Error}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Preview: same resolver as opening repositories. -->
                <Border Margin="0,16,0,0" Padding="12" CornerRadius="4" Background="{StaticResource Brush.Background}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Generated target preview" />
                            <TextBox DockPanel.Dock="Right" Width="140" HorizontalAlignment="Right" FontFamily="Consolas"
                                     Text="{Binding SampleCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sample system code" />
                            <TextBlock DockPanel.Dock="Right" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.MutedText}" Text="Sample System Code" />
                        </DockPanel>
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Preview}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TargetPreviewRow}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                        <TextBlock x:Name="Value" Grid.Column="1" FontFamily="Consolas" TextWrapping="Wrap" Text="{Binding Text}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                            <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Brush.MutedText}" />
                                            <Setter TargetName="Value" Property="FontFamily" Value="Segoe UI" />
                                            <Setter TargetName="Value" Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
