<Window x:Class="WorkHub.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WorkHub.Presentation.ViewModels;assembly=WorkHub.Presentation"
        xmlns:repo="clr-namespace:WorkHub.Core.Repositories;assembly=WorkHub.Core"
        xmlns:views="clr-namespace:WorkHub.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="WorkHub"
        Icon="pack://application:,,,/WorkHub;component/WorkHub.ico"
        Width="1100" Height="720" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Banner" TargetType="Border">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <!--
            Phase 13A LIBRARY row (bottom navigation): full-width, rounded hover, accent bar and Selected background while its
            panel is open (Tag="Selected"; the row's open command is then disabled, which must not look dimmed).
        -->
        <Style x:Key="LibraryRow" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="FocusRing" Margin="-2" CornerRadius="8" BorderThickness="2"
                                    BorderBrush="{StaticResource Brush.Accent}" Visibility="Collapsed" />
                            <Border x:Name="Bd" CornerRadius="6" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                                <Grid>
                                    <Border x:Name="Overlay" CornerRadius="6" Background="Transparent" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{StaticResource Brush.HoverOverlay}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{StaticResource Brush.PressedOverlay}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Opacity" Value="1" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selected}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The Workspace selection menu: ONE definition used by the tree's right-click menu and by the strip's More (⋯) button
            (x:Shared=False gives each use its own instance). Same commands and CanExecute rules as the toolbars.
        -->
        <ContextMenu x:Key="WorkspaceSelectionMenu" x:Shared="False">
            <MenuItem Header="New Folder…" Command="{Binding NewFolderCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.FolderAdd}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="New Project…" Command="{Binding NewProjectCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.ProjectAdd}" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Rename…" InputGestureText="F2" Command="{Binding RenameCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Rename}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Edit Project…" Command="{Binding EditProjectCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Edit}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Move to…" Command="{Binding MoveCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Move}" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Move to Trash…" InputGestureText="Del" Command="{Binding TrashProjectCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Trash}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Archive…" Command="{Binding ArchiveProjectCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Archive}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Archive folder…" Command="{Binding ArchiveFolderCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Archive}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Move folder to Trash…" InputGestureText="Del" Command="{Binding TrashFolderCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Trash}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Remove folder…" InputGestureText="Del" Command="{Binding RemoveFolderCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.FolderRemove}" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Info" InputGestureText="Ctrl+I" Command="{Binding ToggleInfoCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Info}" /></MenuItem.Icon></MenuItem>
        </ContextMenu>

        <!-- Phase 13A: the selection pane switches to compact layouts below these content widths (strip folding, Info overlay). -->
        <views:LessThanConverter x:Key="NarrowerThanInfoDrawer" Threshold="640" />
        <views:LessThanConverter x:Key="NarrowerThanFullToolbar" Threshold="480" />

        <views:DepthToIndentConverter x:Key="WorkspaceIndent" Indent="18" />
        <views:FractionConverter x:Key="PreviewMaxHeight" Fraction="0.4" />
        <views:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <!-- Workspace tree chevron (replaces the default triangle). -->
        <Style x:Key="WorkspaceTreeExpander" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <!-- A drawn chevron (vector path, not a font character): › collapsed, rotated to ⌄ when expanded. -->
                            <Path x:Name="Chevron" Data="M0,0 L3.5,3.5 L0,7" Width="5" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{StaticResource Brush.MutedText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="ChevronRotation" Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Workspace tree row: one full-width Border per node (hover / selected / selected-without-focus, same colors and
            left accent as the Repository ListRow). The indent is applied INSIDE the row (from the node's Depth), and
            children are rendered full-width below it, so every row highlights across the whole catalog width.
            BasedOn keeps the default style's virtualization settings for nested items.
        -->
        <Style x:Key="WorkspaceTreeItem" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,3,8,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Row" Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <Grid Margin="{Binding Depth, Converter={StaticResource WorkspaceIndent}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Style="{StaticResource WorkspaceTreeExpander}" ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Hover}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.SelectedInactive}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Selected}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel LastChildFill="False">
                <!-- Phase 13A brand (logo A). Schema and backup details are in its tooltip and in Settings → Backups. -->
                <StackPanel x:Name="Brand" DockPanel.Dock="Left" Orientation="Horizontal" Background="Transparent"
                            ToolTip="{Binding BrandToolTip}">
                    <!-- Panels are not exposed to UI Automation, so the accessible name and help text live on the Image. -->
                    <Image Source="{StaticResource Logo.Small}" Width="20" Height="20" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.AutomationId="Brand"
                           AutomationProperties.Name="WorkHub" AutomationProperties.HelpText="{Binding BrandToolTip}" />
                    <TextBlock Margin="8,0,0,0" Text="WorkHub" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Only non-routine states (Starting…, Startup failed, Closing): "Ready · schema …" is not shown. -->
                <TextBlock DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding StatusText}"
                           AutomationProperties.AutomationId="StatusText">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.MutedText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Warning}" AutomationProperties.AutomationId="CustomDataRoot"
                           Text="{Binding CustomDataRoot, StringFormat=Test data root: {0}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CustomDataRoot}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" ToolTip="Settings" AutomationProperties.Name="Settings"
                        Command="{Binding Repository.OpenSettingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Settings}" />
                        <TextBlock Margin="6,0,0,0" Text="Settings" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1">
            <!-- Phase 10: restore startup screen (waiting holds the startup Gate only; asking; progress). -->
            <Border Style="{StaticResource Banner}" Background="{StaticResource Brush.WarningBackground}" BorderBrush="{StaticResource Brush.Border}"
                    DataContext="{Binding RestoreScreen}" AutomationProperties.AutomationId="RestoreScreen"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Text}" AutomationProperties.AutomationId="RestoreScreenText" />
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" Text="{Binding Notice}" AutomationProperties.AutomationId="RestoreScreenNotice"
                               Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding NowText}" Command="{Binding NowCommand}" AutomationProperties.Name="{Binding NowText}"
                                Visibility="{Binding IsAsking, Converter={StaticResource BoolToVisibility}}" />
                        <Button Margin="8,0,0,0" Content="Cancel restore" Command="{Binding CancelRestoreCommand}" AutomationProperties.Name="Cancel restore"
                                Visibility="{Binding CanCancelRestore, Converter={StaticResource BoolToVisibility}}" />
                        <Button Margin="8,0,0,0" Content="Not now" Command="{Binding NotNowCommand}" AutomationProperties.Name="Not now"
                                Visibility="{Binding IsAsking, Converter={StaticResource BoolToVisibility}}" />
                        <Button Margin="8,0,0,0" Content="Exit" Command="{Binding ExitCommand}" AutomationProperties.Name="Exit"
                                Visibility="{Binding CanExit, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Startup error (and Phase 10 recovery / Failed-shell restore entry) -->
            <Border Background="{StaticResource Brush.ErrorBackground}" BorderBrush="{StaticResource Brush.Border}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Banner}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" Text="{Binding ErrorMessage}" AutomationProperties.AutomationId="StartupError" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Restore from a backup…" Command="{Binding RestoreFromBackupCommand}" AutomationProperties.Name="Restore from a backup"
                                Visibility="{Binding CanRestoreFromBackup, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Open the Restore folder" Command="{Binding OpenRestoreFolderCommand}" AutomationProperties.Name="Open the Restore folder"
                                Visibility="{Binding IsRecoveryRequired, Converter={StaticResource BoolToVisibility}}" />
                        <Button Margin="8,0,0,0" Content="Exit" Command="{Binding ExitCommand}" AutomationProperties.Name="Exit WorkHub"
                                Visibility="{Binding IsRecoveryRequired, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Phase 10: this window owns an unfinished restore (§10.1). Every write re-reads under the Restore lock. -->
            <Border Style="{StaticResource Banner}" Background="{StaticResource Brush.WarningBackground}" BorderBrush="{StaticResource Brush.Border}"
                    DataContext="{Binding RestoreOwner}" AutomationProperties.AutomationId="RestoreOwner"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding StatusText}" AutomationProperties.AutomationId="RestoreOwnerText" />
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" Text="{Binding Message}"
                               Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Put back previous data" Command="{Binding PutBackCommand}" AutomationProperties.Name="Put back previous data"
                                Visibility="{Binding CanPutBack, Converter={StaticResource BoolToVisibility}}" />
                        <Button Margin="8,0,0,0" Content="Try again" Command="{Binding TryAgainCommand}" AutomationProperties.Name="Try again"
                                Visibility="{Binding CanTryAgain, Converter={StaticResource BoolToVisibility}}" />
                        <Button Margin="8,0,0,0" Content="{Binding RestartText}" Command="{Binding RestartCommand}" AutomationProperties.Name="{Binding RestartText}"
                                Visibility="{Binding CanRestart, Converter={StaticResource BoolToVisibility}}" />
                        <Button Margin="8,0,0,0" Content="Exit" Command="{Binding ExitCommand}" AutomationProperties.Name="Exit after restore problem"
                                Visibility="{Binding CanRestart, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Non-fatal startup warning -->
        <Border Grid.Row="2" Background="{StaticResource Brush.WarningBackground}" BorderBrush="{StaticResource Brush.Border}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Banner}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WarningMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Foreground="{StaticResource Brush.Warning}" TextWrapping="Wrap" Text="{Binding WarningMessage}" />
        </Border>

        <TabControl x:Name="PrimaryTabs" Grid.Row="3" Margin="12" IsEnabled="{Binding IsReady}" Padding="0">
            <TabItem x:Name="RepositoryTab" Header="Repository" Padding="16,4">
                <Grid DataContext="{Binding Navigation}" Background="{StaticResource Brush.Surface}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: the five fixed Repository groups, then the user-defined Owner groups. One active selection. -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="REPOSITORY" />
                        <ListBox x:Name="CategoryList" DockPanel.Dock="Top" BorderThickness="0" Background="Transparent"
                                 ItemsSource="{Binding Repository.Categories}" SelectedItem="{Binding SelectedCategory}"
                                 AutomationProperties.Name="Repository groups">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RepositoryCategoryViewModel}">
                                    <DockPanel Margin="4,3">
                                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="10"
                                                   Foreground="{StaticResource Brush.MutedText}" VerticalAlignment="Center"
                                                   Text="{Binding VersionControl}" />
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border DockPanel.Dock="Top" Margin="12,14,12,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border}" />
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,6,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Padding="6,2" Margin="0,8,0,0"
                                    ToolTip="Add Owner group" AutomationProperties.Name="Add Owner group" Command="{Binding Owner.AddGroupCommand}">
                                <Image Style="{StaticResource IconImage}" Width="12" Height="12" Source="{StaticResource Img.Add}" />
                            </Button>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="OWNER" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="12,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.MutedText}" Text="No Owner groups yet. Use + to add one.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOwnerGroups}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox x:Name="OwnerGroupList" BorderThickness="0" Background="Transparent"
                                 ItemsSource="{Binding Owner.Groups}" SelectedItem="{Binding Owner.SelectedGroup}"
                                 AutomationProperties.Name="Owner groups"
                                 VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OwnerGroupViewModel}">
                                    <TextBlock Margin="4,3" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.InputBindings>
                                <KeyBinding Key="F2" Command="{Binding Owner.RenameGroupCommand}" />
                                <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding Owner.MoveGroupUpCommand}" />
                                <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding Owner.MoveGroupDownCommand}" />
                            </ListBox.InputBindings>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Add Group…" Command="{Binding Owner.AddGroupCommand}" />
                                    <MenuItem Header="Rename…" InputGestureText="F2" Command="{Binding Owner.RenameGroupCommand}" />
                                    <Separator />
                                    <MenuItem Header="Move Up" InputGestureText="Alt+Up" Command="{Binding Owner.MoveGroupUpCommand}" />
                                    <MenuItem Header="Move Down" InputGestureText="Alt+Down" Command="{Binding Owner.MoveGroupDownCommand}" />
                                    <Separator />
                                    <MenuItem Header="Delete Group…" Command="{Binding Owner.DeleteGroupCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="{StaticResource Brush.Border}" Focusable="False" />

                    <!-- Right (Owner group selected): launcher list -->
                    <DockPanel Grid.Column="2" DataContext="{Binding Owner}"
                               Visibility="{Binding DataContext.IsOwnerActive, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BoolToVisibility}}">
                        <Grid DockPanel.Dock="Top" Margin="16,8,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding SelectedGroup.Name}" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Bottom" Foreground="{StaticResource Brush.MutedText}" Text="{Binding CountText}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource ToolButton}" Command="{Binding AddItemCommand}" ToolTip="Add a launcher" AutomationProperties.Name="Add Item">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource IconImage}" Width="14" Height="14" Source="{StaticResource Img.Add}" />
                                    <TextBlock Margin="6,0,0,0" Text="Add Item" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OwnerMoreButton" Grid.Column="3" Style="{StaticResource ToolButton}" ToolTip="More" AutomationProperties.Name="Owner more" Click="OwnerMoreButton_Click">
                                <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.More}" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename Group…" Command="{Binding RenameGroupCommand}" />
                                        <MenuItem Header="Move Group Up" Command="{Binding MoveGroupUpCommand}" />
                                        <MenuItem Header="Move Group Down" Command="{Binding MoveGroupDownCommand}" />
                                        <Separator />
                                        <MenuItem Header="Add Group…" Command="{Binding AddGroupCommand}" />
                                        <MenuItem Header="Delete Group…" Command="{Binding DeleteGroupCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>

                        <!-- Open failure (missing target etc.) with a direct Edit action. -->
                        <Border DockPanel.Dock="Top" Margin="16,0,16,8" Padding="12,8" CornerRadius="4" Background="{StaticResource Brush.WarningBackground}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BannerMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss owner message" Command="{Binding DismissBannerCommand}">
                                    <Image Style="{StaticResource IconImage}" Width="12" Height="12" Source="{StaticResource Img.Dismiss}" />
                                </Button>
                                <Button DockPanel.Dock="Right" Margin="8,0" Content="Edit" AutomationProperties.Name="Edit launcher" Command="{Binding EditFromBannerCommand}"
                                        Visibility="{Binding BannerCanEdit, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}" Text="{Binding BannerMessage}"
                                               AutomationProperties.AutomationId="OwnerBanner" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.MutedText}"
                                               Text="{Binding BannerTarget, StringFormat=Target: {0}}" AutomationProperties.AutomationId="OwnerBannerTarget">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BannerTarget}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border}" Padding="14,0,12,4">
                            <Grid TextElement.Foreground="{StaticResource Brush.MutedText}" TextElement.FontSize="11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Name" />
                                <TextBlock Grid.Column="1" Text="Type" />
                            </Grid>
                        </Border>

                        <Grid>
                            <ListView x:Name="OwnerItemList" BorderThickness="0" Background="Transparent"
                                      ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" SelectionMode="Single"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.Name="Launchers" MouseDoubleClick="OwnerItemList_MouseDoubleClick">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource ListRow}">
                                        <Setter Property="AutomationProperties.Name">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="{}{0} ({1})">
                                                    <Binding Path="Name" />
                                                    <Binding Path="ActionType" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="ToolTip" Value="{Binding Target}" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding OpenItemCommand}" />
                                    <KeyBinding Key="F2" Command="{Binding EditItemCommand}" />
                                    <KeyBinding Key="Delete" Command="{Binding DeleteItemCommand}" />
                                    <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding MoveItemUpCommand}" />
                                    <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding MoveItemDownCommand}" />
                                </ListView.InputBindings>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open" InputGestureText="Enter" FontWeight="SemiBold" Command="{Binding OpenItemCommand}" />
                                        <MenuItem Header="Copy target" Command="{Binding CopyTargetCommand}" />
                                        <Separator />
                                        <MenuItem Header="Edit…" InputGestureText="F2" Command="{Binding EditItemCommand}" />
                                        <MenuItem Header="Move to…" Command="{Binding MoveItemToGroupCommand}" />
                                        <MenuItem Header="Move Up" InputGestureText="Alt+Up" Command="{Binding MoveItemUpCommand}" />
                                        <MenuItem Header="Move Down" InputGestureText="Alt+Down" Command="{Binding MoveItemDownCommand}" />
                                        <Separator />
                                        <MenuItem Header="Delete…" InputGestureText="Del" Command="{Binding DeleteItemCommand}" />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding ActionType}" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Style="{StaticResource EmptyState}" Text="{Binding EmptyStateText}"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DockPanel>

                    <!-- Right (fixed Repository group selected): toolbar, banner, System list -->
                    <DockPanel Grid.Column="2" DataContext="{Binding Repository}"
                               Visibility="{Binding DataContext.IsRepositoryActive, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BoolToVisibility}}">
                        <Grid DockPanel.Dock="Top" Margin="16,8,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding SelectedCategory.DisplayName}" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Bottom" Foreground="{StaticResource Brush.MutedText}" Text="{Binding CountText}" />
                            </StackPanel>

                            <Grid Grid.Column="2" Width="240" Margin="0,0,4,0"
                                  Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Search systems" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                                <TextBlock Margin="7,0" IsHitTestVisible="False" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.MutedText}" Text="Search code or name…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Button Grid.Column="3" Style="{StaticResource ToolButton}" ToolTip="Search (Ctrl+F)" AutomationProperties.Name="Search" Click="SearchButton_Click">
                                <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Search}" />
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource ToolButton}" Command="{Binding AddSystemCommand}" ToolTip="Add a System" AutomationProperties.Name="Add System">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource IconImage}" Width="14" Height="14" Source="{StaticResource Img.Add}" />
                                    <TextBlock Margin="6,0,0,0" Text="Add System" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="MoreButton" Grid.Column="5" Style="{StaticResource ToolButton}" ToolTip="More" AutomationProperties.Name="More" Click="MoreButton_Click">
                                <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.More}" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Show inactive systems" IsCheckable="True" IsChecked="{Binding ShowInactive}" />
                                        <Separator />
                                        <MenuItem Header="Repository settings…" Command="{Binding OpenSettingsCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>

                        <!-- Repository warning (e.g. missing TortoiseSVN / host) with a direct fix action. -->
                        <Border DockPanel.Dock="Top" Margin="16,0,16,8" Padding="12,8" CornerRadius="4"
                                Background="{StaticResource Brush.WarningBackground}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BannerMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Command="{Binding DismissBannerCommand}">
                                    <Image Style="{StaticResource IconImage}" Width="12" Height="12" Source="{StaticResource Img.Dismiss}" />
                                </Button>
                                <Button DockPanel.Dock="Right" Margin="8,0" Content="Fix Settings" Command="{Binding FixSettingsCommand}"
                                        Visibility="{Binding BannerCanFixSettings, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}" Text="{Binding BannerMessage}" AutomationProperties.AutomationId="RepositoryBanner" />
                            </DockPanel>
                        </Border>

                        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border}" Padding="14,0,12,4">
                            <Grid TextElement.Foreground="{StaticResource Brush.MutedText}" TextElement.FontSize="11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="System Code" />
                                <TextBlock Grid.Column="1" Text="System Name" />
                            </Grid>
                        </Border>

                        <Grid>
                            <ListView x:Name="SystemList" BorderThickness="0" Background="Transparent"
                                      ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                      SelectionMode="Single"
                                      
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.Name="Systems"
                                      MouseDoubleClick="SystemList_MouseDoubleClick">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource ListRow}">
                                        <Setter Property="AutomationProperties.Name">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="SystemCode" />
                                                    <Binding Path="SystemName" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding OpenSelectedCommand}" />
                                    <KeyBinding Key="F2" Command="{Binding EditSystemCommand}" />
                                </ListView.InputBindings>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open" InputGestureText="Enter" FontWeight="SemiBold" Command="{Binding OpenSelectedCommand}" />
                                        <MenuItem Header="Copy target" Command="{Binding CopyTargetCommand}" />
                                        <Separator />
                                        <MenuItem Header="Edit…" InputGestureText="F2" Command="{Binding EditSystemCommand}" />
                                        <MenuItem Command="{Binding ToggleActiveCommand}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="Deactivate" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedIsActive}" Value="False">
                                                            <Setter Property="Header" Value="Reactivate" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Delete permanently…" Command="{Binding DeletePermanentlyCommand}" />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type repo:SystemListItem}">
                                        <Grid x:Name="Row">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SystemCode}" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding SystemName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Border x:Name="CustomTag" Style="{StaticResource Tag}" Visibility="Collapsed" ToolTip="{Binding CustomTarget}">
                                                    <TextBlock FontSize="10" Text="custom target" Foreground="{StaticResource Brush.MutedText}" />
                                                </Border>
                                                <Border x:Name="InactiveTag" Style="{StaticResource Tag}" Visibility="Collapsed">
                                                    <TextBlock FontSize="10" Text="inactive" Foreground="{StaticResource Brush.MutedText}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasCustomTarget}" Value="True">
                                                <Setter TargetName="CustomTag" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter TargetName="InactiveTag" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Style="{StaticResource EmptyState}" Text="{Binding EmptyStateText}"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="WorkspaceTab" Header="Workspace" Padding="16,4" IsSelected="{Binding Workspace.IsTabSelected, Mode=TwoWay}">
                <Grid Background="{StaticResource Brush.Surface}" DataContext="{Binding Workspace}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" MinWidth="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Workspace banner (errors that did not change anything) -->
                    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource Brush.ErrorBackground}" BorderBrush="{StaticResource Brush.Border}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Banner}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BannerMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding DismissBannerCommand}"
                                    AutomationProperties.Name="Dismiss workspace message" Content="Dismiss" />
                            <!-- Undo of the latest Move to Trash or Archive: offered only in the Workspace visit that started it. -->
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding UndoCommand}" FontWeight="SemiBold"
                                    Visibility="{Binding IsUndoAvailable, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Undo" ToolTip="Undo the move to the Trash or the archive shown in this message" Content="Undo" />
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap"
                                       Text="{Binding BannerMessage}" AutomationProperties.AutomationId="WorkspaceBanner" />
                        </DockPanel>
                    </Border>

                    <!-- Tree -->
                    <DockPanel Grid.Row="1" Grid.Column="0">
                        <!-- The tree toolbar (Settings → Workspace → "Show the tree toolbar"). Right-click: hide only this toolbar. -->
                        <WrapPanel x:Name="TreeToolbar" DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,6" AutomationProperties.Name="Tree toolbar"
                                   Background="Transparent" Visibility="{Binding ShowTreeToolbar, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Hide tree toolbar" Command="{Binding Preferences.HideTreeToolbarCommand}" />
                                </ContextMenu>
                            </WrapPanel.ContextMenu>
                            <Button Style="{StaticResource PillButton}" Command="{Binding NewFolderCommand}"
                                    AutomationProperties.Name="New Folder" ToolTip="New folder (a WorkHub reference only)" Margin="2,2">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.FolderAdd}" />
                                    <TextBlock Margin="6,0,0,0" Text="Folder" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PillButton}" Command="{Binding NewProjectCommand}"
                                    AutomationProperties.Name="New Project" ToolTip="New project" Margin="2,2">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.ProjectAdd}" />
                                    <TextBlock Margin="6,0,0,0" Text="Project" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconPillButton}" Command="{Binding RenameCommand}" AutomationProperties.Name="Rename" ToolTip="Rename (F2)" Margin="2,2">
                                <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Rename}" />
                            </Button>
                            <Button Style="{StaticResource IconPillButton}" Command="{Binding MoveCommand}" AutomationProperties.Name="Move to" ToolTip="Move to…" Margin="2,2">
                                <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Move}" />
                            </Button>
                            <Button Style="{StaticResource IconPillButton}"
                                    Command="{Binding ArchiveProjectCommand}" AutomationProperties.Name="Archive project" Margin="2,2"
                                    ToolTip="Archive the project: it leaves the tree and is listed under Archived projects. Its content stays with it; nothing on disk is touched.">
                                <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Archive}" />
                            </Button>
                            <Button Style="{StaticResource IconPillButton}"
                                    Command="{Binding TrashProjectCommand}" AutomationProperties.Name="Move project to Trash" Margin="2,2"
                                    ToolTip="Move the project to the Trash (Del). Its content stays with it; nothing on disk is touched.">
                                <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Trash}" />
                            </Button>
                            <Button Style="{StaticResource IconPillButton}"
                                    Command="{Binding ArchiveFolderCommand}" AutomationProperties.Name="Archive folder" Margin="2,2"
                                    ToolTip="Archive the folder and everything in it: it leaves the tree and is listed under Archived. Nothing on disk is touched.">
                                <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Archive}" />
                            </Button>
                            <Button Style="{StaticResource IconPillButton}"
                                    Command="{Binding TrashFolderCommand}" AutomationProperties.Name="Move folder to Trash" Margin="2,2"
                                    ToolTip="Move the folder and everything in it to the Trash (Del on a non-empty folder). Nothing on disk is touched.">
                                <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Trash}" />
                            </Button>
                            <Button Style="{StaticResource IconPillButton}" Command="{Binding RemoveFolderCommand}" AutomationProperties.Name="Remove empty folder" Margin="2,2"
                                    ToolTip="Remove an empty folder (Del). Only the WorkHub folder is removed; nothing on disk is touched.">
                                <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.FolderRemove}" />
                            </Button>
                        </WrapPanel>

                        <!--
                            Phase 13A LIBRARY: docked at the BOTTOM and declared before the tree, so it keeps its height and a long
                            tree (which fills the rest and scrolls) can never push it out of view. Same lower-section pattern as
                            OWNER in Repository. Each row opens its panel and shows the selected state while that panel is open.
                        -->
                        <StackPanel x:Name="LibrarySection" DockPanel.Dock="Bottom" Margin="0,4,0,8" AutomationProperties.Name="Library">
                            <Border Margin="12,0,12,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border}" />
                            <TextBlock Style="{StaticResource SectionHeader}" Margin="12,10,12,4" Text="LIBRARY" />
                            <Button Command="{Binding OpenArchivedCommand}" AutomationProperties.Name="Archived"
                                    AutomationProperties.AutomationId="OpenArchivedProjects"
                                    ToolTip="Archived folders and projects (unarchive them from here) · Ctrl+Shift+A">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LibraryRow}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsArchivedOpen}" Value="True">
                                                <Setter Property="Tag" Value="Selected" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <DockPanel>
                                    <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Archive}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Archived.ButtonText}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                            <Button Command="{Binding OpenTrashCommand}" AutomationProperties.Name="Trash"
                                    AutomationProperties.AutomationId="OpenWorkspaceTrash"
                                    ToolTip="Folders and projects in the Workspace Trash (restore them from here) · Ctrl+Shift+T">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LibraryRow}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTrashOpen}" Value="True">
                                                <Setter Property="Tag" Value="Selected" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <DockPanel>
                                    <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Trash}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Trash.ButtonText}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                        </StackPanel>

                        <!--
                            Search (Ctrl+F): the results replace the tree while the query is non-empty; Esc clears it. With the tree
                            toolbar hidden, a compact More (⋯) beside it opens the tree's menu (New Folder, New Project, …).
                        -->
                        <DockPanel DockPanel.Dock="Top">
                            <Button x:Name="TreeMoreButton" DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource IconPillButton}" Margin="0,0,8,4"
                                    AutomationProperties.Name="More tree actions" ToolTip="Tree actions (the tree toolbar is hidden; show it in Settings → Workspace)"
                                    Click="TreeMoreButton_Click" ContextMenu="{StaticResource WorkspaceSelectionMenu}"
                                    Visibility="{Binding ShowTreeToolbar, Converter={StaticResource InverseBoolToVisibility}}">
                                <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.More}" />
                            </Button>
                            <StackPanel Margin="8,0,8,4" DataContext="{Binding Search}"
                                        Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                                <Grid>
                                    <TextBox x:Name="WorkspaceSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="22,3,24,3"
                                             AutomationProperties.Name="Search workspace" PreviewKeyDown="WorkspaceSearchBox_PreviewKeyDown" />
                                    <Image Style="{StaticResource IconImage}" Width="14" Height="14" Margin="5,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                                           Source="{StaticResource Img.Search}" />
                                    <TextBlock Margin="24,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.MutedText}" Text="Search workspace (Ctrl+F)">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=WorkspaceSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource ToolButton}" Padding="4,0" Command="{Binding ClearCommand}"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.Name="Clear search" ToolTip="Clear search (Esc)">
                                        <Image Style="{StaticResource IconImage}" Width="12" Height="12" Source="{StaticResource Img.Dismiss}" />
                                    </Button>
                                </Grid>
                                <TextBlock Margin="2,4,2,0" Foreground="{StaticResource Brush.MutedText}" TextWrapping="Wrap" Text="{Binding StatusText}"
                                           AutomationProperties.AutomationId="WorkspaceSearchStatus"
                                           Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />
                                <DockPanel Margin="2,4,2,0" Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Retry" Command="{Binding RetryCommand}" AutomationProperties.Name="Retry search" />
                                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" Text="{Binding ErrorText}"
                                               AutomationProperties.AutomationId="WorkspaceSearchError" />
                                </DockPanel>
                                <TextBlock Margin="2,4,2,0" Foreground="{StaticResource Brush.Warning}" TextWrapping="Wrap" Text="{Binding NoticeText}"
                                           AutomationProperties.AutomationId="WorkspaceSearchNotice"
                                           Visibility="{Binding NoticeText, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </DockPanel>

                        <Grid>
                            <ListBox x:Name="WorkspaceSearchResults" DataContext="{Binding Search}" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                                     BorderThickness="0" Background="Transparent" AutomationProperties.Name="Search results"
                                     VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewKeyDown="WorkspaceSearchResults_PreviewKeyDown" MouseDoubleClick="WorkspaceSearchResults_MouseDoubleClick">
                                <ListBox.Style>
                                    <Style TargetType="ListBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="6,4" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:WorkspaceSearchHitViewModel}">
                                        <DockPanel ToolTip="{Binding Location}">
                                            <Image x:Name="Glyph" DockPanel.Dock="Left" Style="{StaticResource IconImage}" VerticalAlignment="Top" Margin="0,2,8,0"
                                                   Source="{StaticResource Img.Folder}" />
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="{StaticResource Brush.MutedText}" FontSize="11" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Location, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Foreground="{StaticResource Brush.MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding MatchText}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <!-- The same icon per kind as in the tree and the content list. -->
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding KindText}" Value="Project">
                                                <Setter TargetName="Glyph" Property="Source" Value="{StaticResource Img.Project}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding KindText}" Value="Link">
                                                <Setter TargetName="Glyph" Property="Source" Value="{StaticResource Img.Link}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding KindText}" Value="Note">
                                                <Setter TargetName="Glyph" Property="Source" Value="{StaticResource Img.Note}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TreeView x:Name="WorkspaceTree" BorderThickness="0" Background="Transparent" Padding="0"
                                      ItemsSource="{Binding Roots}" AutomationProperties.Name="Workspace tree"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      PreviewMouseRightButtonDown="WorkspaceTree_PreviewMouseRightButtonDown"
                                      PreviewMouseLeftButtonDown="WorkspaceTree_PreviewMouseLeftButtonDown"
                                      TreeViewItem.Selected="WorkspaceTree_ItemSelected"
                                      Visibility="{Binding Search.IsActive, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Visible}">
                                <TreeView.InputBindings>
                                    <KeyBinding Key="F2" Command="{Binding RenameCommand}" />
                                    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                                </TreeView.InputBindings>
                                <TreeView.ItemContainerStyle>
                                    <StaticResource ResourceKey="WorkspaceTreeItem" />
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:WorkspaceNodeViewModel}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image x:Name="Glyph" Style="{StaticResource IconImage}" Source="{StaticResource Img.Folder}" />
                                            <TextBlock x:Name="Label" Margin="6,1,4,1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <HierarchicalDataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsProject}" Value="True">
                                                <Setter TargetName="Glyph" Property="Source" Value="{StaticResource Img.Project}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.MutedText}" />
                                            </DataTrigger>
                                        </HierarchicalDataTemplate.Triggers>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                                <TreeView.ContextMenu>
                                    <StaticResource ResourceKey="WorkspaceSelectionMenu" />
                                </TreeView.ContextMenu>
                            </TreeView>

                            <TextBlock Style="{StaticResource EmptyState}" Text="Workspace is empty. Create a folder or project."
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource EmptyState}" Text="Loading…"
                                       Visibility="{Binding IsLoadingRoots, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RootLoadError}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding RootLoadError}" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Center" Content="Retry" Command="{Binding RetryLoadCommand}" AutomationProperties.Name="Retry loading Workspace" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="{StaticResource Brush.Border}" />

                    <!--
                        Details (top, scrolls on its own) and the selected Project's content (fills the rest). The content
                        list is not inside a ScrollViewer, so its own VirtualizingStackPanel keeps virtualizing.
                    -->
                    <!--
                        The Workspace Trash replaces the details and content while open (D6). The selection and its content view
                        stay as they are behind it; Back (or selecting a tree node) shows them again. Restore never selects.
                    -->
                    <DockPanel Grid.Row="1" Grid.Column="2" Margin="20,12,20,12" DataContext="{Binding Trash}"
                               Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Workspace Trash">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding DataContext.CloseTrashCommand, ElementName=WorkspaceTree}"
                                    AutomationProperties.Name="Back from Workspace Trash" ToolTip="Back to the selected folder or project">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Back}" />
                                    <TextBlock Margin="6,0,0,0" Text="Back" />
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding RestoreCommand}" AutomationProperties.Name="Restore"
                                    ToolTip="Restore the selected folder or project to the folder it came from, under its own name (Enter)" Content="Restore" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ButtonText}" AutomationProperties.AutomationId="WorkspaceTrashTitle" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding Notice}" AutomationProperties.AutomationId="WorkspaceTrashNotice"
                                   Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldHint}" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Text="Folders and projects in the Trash keep everything in them and are kept until you restore them, to the same place and name. Nothing on disk was moved or deleted." />
                        <Grid>
                            <ListView x:Name="WorkspaceTrashList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" BorderThickness="0" Background="Transparent"
                                      AutomationProperties.Name="Trash list" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      PreviewKeyDown="WorkspaceTrashList_PreviewKeyDown">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource ListRow}">
                                        <Setter Property="Padding" Value="8,5" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:WorkspaceTrashEntryViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="2*" MinWidth="80" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <Image x:Name="Glyph" VerticalAlignment="Center" Style="{StaticResource IconImage}" Source="{StaticResource Img.Project}" />
                                            <TextBlock Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}"
                                                       Text="{Binding FromText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FromText}" />
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}" Text="{Binding TrashedAtText}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                <Setter TargetName="Glyph" Property="Source" Value="{StaticResource Img.Folder}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Restore" InputGestureText="Enter" Command="{Binding RestoreCommand}" />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>
                            <TextBlock Style="{StaticResource EmptyState}" Text="Nothing is in the Trash." Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                                       AutomationProperties.AutomationId="WorkspaceTrashEmpty" />
                            <TextBlock Style="{StaticResource EmptyState}" Text="Loading the Trash…" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource EmptyState}" Foreground="{StaticResource Brush.Error}" Text="{Binding LoadError}"
                                       Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsed}}" />
                        </Grid>
                    </DockPanel>

                    <!--
                        The Archived projects panel replaces the details and content while open (Phase 12 A4), exactly like the
                        Workspace Trash: the selection and its content view stay behind it; Unarchive never selects.
                    -->
                    <DockPanel Grid.Row="1" Grid.Column="2" Margin="20,12,20,12" DataContext="{Binding Archived}"
                               Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Archived projects">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding DataContext.CloseArchivedCommand, ElementName=WorkspaceTree}"
                                    AutomationProperties.Name="Back from Archived projects" ToolTip="Back to the selected folder or project">
                                <StackPanel Orientation="Horizontal">
                                    <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Back}" />
                                    <TextBlock Margin="6,0,0,0" Text="Back" />
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding UnarchiveCommand}" AutomationProperties.Name="Unarchive"
                                    ToolTip="Unarchive the selected folder or project into its folder (a project asks for its status) (Enter)" Content="Unarchive…" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ButtonText}" AutomationProperties.AutomationId="ArchivedProjectsTitle" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding Notice}" AutomationProperties.AutomationId="ArchivedProjectsNotice"
                                   Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldHint}" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Text="Archived folders and projects keep everything in them and their place and name. Nothing on disk was moved or deleted." />
                        <Grid>
                            <ListView x:Name="ArchivedProjectsList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" BorderThickness="0" Background="Transparent"
                                      AutomationProperties.Name="Archived list" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      PreviewKeyDown="ArchivedProjectsList_PreviewKeyDown">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource ListRow}">
                                        <Setter Property="Padding" Value="8,5" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ArchivedProjectEntryViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="2*" MinWidth="80" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <Image x:Name="Glyph" VerticalAlignment="Center" Style="{StaticResource IconImage}" Source="{StaticResource Img.Project}" />
                                            <TextBlock Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}"
                                                       Text="{Binding LocationText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LocationText}" />
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}" Text="{Binding UpdatedText}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                <Setter TargetName="Glyph" Property="Source" Value="{StaticResource Img.Folder}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Unarchive…" InputGestureText="Enter" Command="{Binding UnarchiveCommand}" />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>
                            <TextBlock Style="{StaticResource EmptyState}" Text="Nothing is archived." Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                                       AutomationProperties.AutomationId="ArchivedProjectsEmpty" />
                            <TextBlock Style="{StaticResource EmptyState}" Text="Loading archived projects…" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource EmptyState}" Foreground="{StaticResource Brush.Error}" Text="{Binding LoadError}"
                                       Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsed}}" />
                        </Grid>
                    </DockPanel>

                    <!--
                        Phase 13A selection pane: a compact header (title, location, one strip with Status / Created / Updated,
                        Info, the hideable selection toolbar and More) and below it the selected Project's Content, which takes
                        all the remaining space. Info is a drawer to the right of Content (an overlay sheet when narrow).
                    -->
                    <Grid x:Name="SelectionPane" Grid.Row="1" Grid.Column="2" Visibility="{Binding IsPanelOpen, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="20,8,20,4">
                            <TextBlock HorizontalAlignment="Left" Margin="0" Text="Select a folder or project.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyState}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SelectedNode}" Value="{x:Null}" />
                                                    <Condition Binding="{Binding IsActivated}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Title line: name and location (the location is muted and trims first). -->
                            <DockPanel Visibility="{Binding SelectedNode, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock DockPanel.Dock="Left" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Text="{Binding SelectedNode.Name}" ToolTip="{Binding SelectedNode.Name}" TextTrimming="CharacterEllipsis"
                                           MaxWidth="{Binding ActualWidth, ElementName=SelectionPane}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="AutomationProperties.AutomationId" Value="SelectedProjectName" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFolderSelected}" Value="True">
                                                    <Setter Property="AutomationProperties.AutomationId" Value="SelectedFolderName" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}"
                                           Text="{Binding SelectedLocation}" ToolTip="{Binding SelectedNode.Path}" TextTrimming="CharacterEllipsis"
                                           AutomationProperties.AutomationId="SelectedLocation" />
                            </DockPanel>

                            <TextBlock Style="{StaticResource FieldHint}" Text="Loading project…"
                                       Visibility="{Binding IsLoadingDetails, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource FieldError}" FontSize="12" Text="{Binding DetailsMessage}" AutomationProperties.AutomationId="DetailsMessage" />

                            <!--
                                The strip (WrapPanel: wraps instead of trimming). Order: status pill, Created, Updated, Info, the
                                hideable selection toolbar, busy indicator, More (always last, always visible). Right-click: show or
                                hide the toolbar.
                            -->
                            <Border x:Name="SelectionStrip" Margin="0,4,0,0" Padding="6,1" CornerRadius="16" HorizontalAlignment="Left"
                                    Background="{StaticResource Brush.Strip}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                    AutomationProperties.Name="Selection strip" AutomationProperties.AutomationId="SelectionStrip"
                                    Visibility="{Binding SelectedNode, Converter={StaticResource NullToCollapsed}}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Show selection toolbar" Command="{Binding Preferences.ShowSelectionToolbarCommand}" />
                                        <MenuItem Header="Hide selection toolbar" Command="{Binding Preferences.HideSelectionToolbarCommand}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <WrapPanel x:Name="StripItems" Orientation="Horizontal">
                                    <!--
                                        Project facts (once its details are loaded): THREE separate wrapping units, so each can move to the
                                        next line on its own; a label never separates from its value.
                                    -->
                                    <Border x:Name="StripStatusUnit" CornerRadius="10" Padding="9,2" Margin="2,1,10,1" Height="24"
                                            Background="{StaticResource Status.Chip}" VerticalAlignment="Center"
                                            Visibility="{Binding SelectedProject, Converter={StaticResource NullToCollapsed}}">
                                        <TextBlock Foreground="{StaticResource Status.Text}" FontWeight="SemiBold" Text="{Binding SelectedProjectStatus}" VerticalAlignment="Center"
                                                   TextTrimming="None" TextWrapping="NoWrap" AutomationProperties.AutomationId="SelectedProjectStatus" />
                                    </Border>
                                    <StackPanel x:Name="StripCreatedUnit" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,12,1" Height="24"
                                                Visibility="{Binding SelectedProject, Converter={StaticResource NullToCollapsed}}">
                                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}" Text="Created" />
                                        <TextBlock x:Name="StripCreated" Margin="5,0,0,0" VerticalAlignment="Center" TextTrimming="None" TextWrapping="NoWrap"
                                                   Text="{Binding SelectedProject.CreatedAt.LocalDateTime, StringFormat='yyyy-MM-dd'}"
                                                   ToolTip="{Binding SelectedProject.CreatedAt.LocalDateTime, StringFormat='yyyy-MM-dd HH:mm'}"
                                                   AutomationProperties.AutomationId="SelectedProjectCreated" />
                                    </StackPanel>
                                    <StackPanel x:Name="StripUpdatedUnit" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,12,1" Height="24"
                                                Visibility="{Binding SelectedProject, Converter={StaticResource NullToCollapsed}}">
                                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}" Text="Updated" />
                                        <TextBlock x:Name="StripUpdated" Margin="5,0,0,0" VerticalAlignment="Center" TextTrimming="None" TextWrapping="NoWrap"
                                                   Text="{Binding SelectedProject.UpdatedAt.LocalDateTime, StringFormat='yyyy-MM-dd HH:mm'}"
                                                   ToolTip="{Binding SelectedProject.UpdatedAt.LocalDateTime, StringFormat='yyyy-MM-dd HH:mm'}"
                                                   AutomationProperties.AutomationId="SelectedProjectUpdated" />
                                    </StackPanel>

                                    <ToggleButton x:Name="InfoToggle" Margin="2,1"
                                                  IsChecked="{Binding IsInfoOpen, Mode=TwoWay}" IsEnabled="{Binding CanOpenInfo}"
                                                  ToolTip="Show the selected project's or folder's details (Ctrl+I)">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource TogglePillButton}">
                                                <Setter Property="AutomationProperties.Name" Value="Project info" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolderSelected}" Value="True">
                                                        <Setter Property="AutomationProperties.Name" Value="Folder info" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Info}" />
                                            <TextBlock Margin="6,0,0,0" Text="Info" />
                                        </StackPanel>
                                    </ToggleButton>

                                    <!-- The hideable selection toolbar (Settings → Workspace). Project actions: -->
                                    <StackPanel x:Name="ProjectSelectionToolbar" Orientation="Horizontal" Margin="6,1,0,1" AutomationProperties.Name="Selection toolbar">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ShowSelectionToolbar}" Value="True" />
                                                            <Condition Binding="{Binding SelectedNode.IsProject}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Style="{StaticResource IconPillButton}"
                                                Command="{Binding EditProjectCommand}" AutomationProperties.Name="Edit Project" ToolTip="Edit project…">
                                            <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Edit}" />
                                        </Button>
                                        <Button Command="{Binding MoveCommand}" AutomationProperties.Name="Move project" ToolTip="Move to…">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconPillButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActualWidth, ElementName=SelectionPane, Converter={StaticResource NarrowerThanFullToolbar}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Move}" />
                                        </Button>
                                        <Button Style="{StaticResource IconPillButton}"
                                                Command="{Binding ArchiveProjectCommand}" AutomationProperties.Name="Archive project (details)" ToolTip="Archive…">
                                            <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Archive}" />
                                        </Button>
                                        <Button Command="{Binding TrashProjectCommand}" AutomationProperties.Name="Move project to Trash (details)" ToolTip="Move to Trash… (Del)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconPillButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActualWidth, ElementName=SelectionPane, Converter={StaticResource NarrowerThanFullToolbar}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Trash}" />
                                        </Button>
                                    </StackPanel>
                                    <!-- ... and Folder actions (same setting). -->
                                    <StackPanel x:Name="FolderSelectionToolbar" Orientation="Horizontal" Margin="6,1,0,1" AutomationProperties.Name="Folder toolbar">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ShowSelectionToolbar}" Value="True" />
                                                            <Condition Binding="{Binding IsFolderSelected}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Style="{StaticResource IconPillButton}" Command="{Binding RenameCommand}" AutomationProperties.Name="Rename folder" ToolTip="Rename… (F2)">
                                            <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Rename}" />
                                        </Button>
                                        <Button Style="{StaticResource IconPillButton}" Command="{Binding MoveCommand}" AutomationProperties.Name="Move folder" ToolTip="Move to…">
                                            <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Move}" />
                                        </Button>
                                        <Button Style="{StaticResource IconPillButton}" Command="{Binding ArchiveFolderCommand}" AutomationProperties.Name="Archive folder (details)" ToolTip="Archive folder…">
                                            <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Archive}" />
                                        </Button>
                                        <Button Style="{StaticResource IconPillButton}" Command="{Binding TrashFolderCommand}" AutomationProperties.Name="Move folder to Trash (details)" ToolTip="Move folder to Trash… (Del)">
                                            <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Trash}" />
                                        </Button>
                                        <Button Style="{StaticResource IconPillButton}" Command="{Binding RemoveFolderCommand}" AutomationProperties.Name="Remove folder" ToolTip="Remove empty folder…">
                                            <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.FolderRemove}" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Busy: a lifecycle write is pending (its commands are disabled meanwhile). -->
                                    <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}" Text="Working…"
                                               AutomationProperties.AutomationId="WorkspaceBusy"
                                               Visibility="{Binding IsLifecycleBusy, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- More (⋯): always visible; the same menu as the tree's right-click menu. -->
                                    <Button x:Name="SelectionMoreButton" Style="{StaticResource IconPillButton}" Margin="6,1,2,1"
                                            AutomationProperties.Name="More actions" ToolTip="More actions" Click="SelectionMoreButton_Click"
                                            ContextMenu="{StaticResource WorkspaceSelectionMenu}">
                                        <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.More}" />
                                    </Button>
                                </WrapPanel>
                            </Border>
                        </StackPanel>

                        <!-- A folder (or nothing) selected: the hint below the strip. -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="20,8,20,12" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap"
                                   Style="{StaticResource FieldHint}" Text="Folders are WorkHub references only. Select a project to see its content."
                                   Visibility="{Binding IsFolderSelected, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Project content: ProjectFolders and Links of one container at a time (never shown in the tree). -->
                    <DockPanel Grid.Row="1" Grid.Column="0" Margin="20,0,20,12" DataContext="{Binding SelectedContent}">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <!--
                            Phase 13A content header: ONE wrapping row with the breadcrumb and the content actions (they wrap to a
                            second line only when the pane is too narrow). Actions without a label keep their accessible name and
                            tooltip; keys and the content right-click menu are unchanged.
                        -->
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,3,0,0"
                                Background="Transparent" Tag="{Binding DataContext, ElementName=WorkspaceTree}">
                            <!-- Right-click: show or hide only the content toolbar (the breadcrumb always stays). -->
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Show content toolbar" Command="{Binding PlacementTarget.Tag.Preferences.ShowContentToolbarCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Hide content toolbar" Command="{Binding PlacementTarget.Tag.Preferences.HideContentToolbarCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <WrapPanel x:Name="ContentHeaderRow">
                                <ItemsControl x:Name="ContentBreadcrumb" Margin="0,1,12,1" VerticalAlignment="Center" ItemsSource="{Binding Breadcrumb}"
                                              AutomationProperties.Name="Content location" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ContentCrumbViewModel}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Separator" Margin="2,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}" Text="›" />
                                                <Button Style="{StaticResource ToolButton}" Padding="4,2" Content="{Binding Name}" Command="{Binding NavigateCommand}"
                                                        AutomationProperties.Name="{Binding Name}" ToolTip="Go to this folder" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                    <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- The content toolbar (Settings → Workspace → "Show the content toolbar"); not shown in the project Trash. -->
                                <WrapPanel x:Name="ContentToolbar" Margin="0,1" AutomationProperties.Name="Content toolbar">
                                    <WrapPanel.Style>
                                        <Style TargetType="WrapPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsTrashOpen}" Value="False" />
                                                        <Condition Binding="{Binding DataContext.ShowContentToolbar, ElementName=WorkspaceTree}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </WrapPanel.Style>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding GoUpCommand}" AutomationProperties.Name="Up one level" ToolTip="Up one level (Backspace)">
                                        <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Up}" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding NewFolderCommand}" AutomationProperties.Name="New content folder" ToolTip="New folder (a WorkHub reference only)">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.FolderAdd}" />
                                            <TextBlock Margin="6,0,0,0" Text="Folder" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding NewLinkCommand}" AutomationProperties.Name="New link" ToolTip="New link to a folder, file or web page">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.LinkAdd}" />
                                            <TextBlock Margin="6,0,0,0" Text="Link" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding NewNoteCommand}" AutomationProperties.Name="New note" ToolTip="New plain-text note">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.NoteAdd}" />
                                            <TextBlock Margin="6,0,0,0" Text="Note" />
                                        </StackPanel>
                                    </Button>
                                    <Border Width="1" Margin="4,5" Background="{StaticResource Brush.Border}" />
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding OpenCommand}" AutomationProperties.Name="Open" ToolTip="Open (Enter)">
                                        <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Open}" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding EditCommand}" AutomationProperties.Name="Edit content item" ToolTip="Edit… — rename folder / edit link / edit note (F2)">
                                        <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Edit}" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding MoveCommand}" AutomationProperties.Name="Move content item" ToolTip="Move to… — within this project">
                                        <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Move}" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding MoveToTrashCommand}" AutomationProperties.Name="Move to Trash" ToolTip="Move to the Trash (Del). Files on disk are not touched.">
                                        <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Trash}" />
                                    </Button>
                                    <Border Width="1" Margin="4,5" Background="{StaticResource Brush.Border}" />
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding CheckCommand}" AutomationProperties.Name="Check link" ToolTip="Check — whether the selected link's folder or file can be found">
                                        <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Check}" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding CheckAllCommand}" AutomationProperties.Name="Check all links" ToolTip="Check all — every link in this folder">
                                        <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.CheckAll}" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding StopCheckingCommand}" AutomationProperties.Name="Stop checking" ToolTip="Stop checking">
                                        <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Stop}" />
                                    </Button>
                                    <Border Width="1" Margin="4,5" Background="{StaticResource Brush.Border}" />
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding OpenTrashCommand}" AutomationProperties.Name="Open Trash" ToolTip="This project's Trash" Content="{Binding TrashButtonText}"
                                            AutomationProperties.AutomationId="OpenTrash" />
                                </WrapPanel>

                                <!-- The content toolbar hidden: one compact More (⋯) with every content action, including Up and Trash. -->
                                <Button x:Name="ContentMoreButton" Margin="0,1"
                                        AutomationProperties.Name="More content actions" ToolTip="Content actions (the content toolbar is hidden)"
                                        Click="ContentMoreButton_Click" Tag="{Binding DataContext, ElementName=WorkspaceTree}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconPillButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsTrashOpen}" Value="False" />
                                                        <Condition Binding="{Binding DataContext.ShowContentToolbar, ElementName=WorkspaceTree}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Up one level" InputGestureText="Backspace" Command="{Binding GoUpCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Up}" /></MenuItem.Icon></MenuItem>
                                            <Separator />
                                            <MenuItem Header="New Folder…" Command="{Binding NewFolderCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.FolderAdd}" /></MenuItem.Icon></MenuItem>
                                            <MenuItem Header="New Link…" Command="{Binding NewLinkCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.LinkAdd}" /></MenuItem.Icon></MenuItem>
                                            <MenuItem Header="New Note…" Command="{Binding NewNoteCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.NoteAdd}" /></MenuItem.Icon></MenuItem>
                                            <Separator />
                                            <MenuItem Header="Open" InputGestureText="Enter" Command="{Binding OpenCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Open}" /></MenuItem.Icon></MenuItem>
                                            <MenuItem Header="Edit…" InputGestureText="F2" Command="{Binding EditCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Edit}" /></MenuItem.Icon></MenuItem>
                                            <MenuItem Header="Move to…" Command="{Binding MoveCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Move}" /></MenuItem.Icon></MenuItem>
                                            <MenuItem Header="Move to Trash" InputGestureText="Del" Command="{Binding MoveToTrashCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Trash}" /></MenuItem.Icon></MenuItem>
                                            <Separator />
                                            <MenuItem Header="Check" Command="{Binding CheckCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Check}" /></MenuItem.Icon></MenuItem>
                                            <MenuItem Header="Check all" Command="{Binding CheckAllCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.CheckAll}" /></MenuItem.Icon></MenuItem>
                                            <MenuItem Header="Stop checking" Command="{Binding StopCheckingCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Stop}" /></MenuItem.Icon></MenuItem>
                                            <Separator />
                                            <MenuItem Header="{Binding TrashButtonText}" Command="{Binding OpenTrashCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Trash}" /></MenuItem.Icon></MenuItem>
                                            <MenuItem Header="Show content toolbar" Command="{Binding PlacementTarget.Tag.Preferences.ShowContentToolbarCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.More}" />
                                </Button>
                            </WrapPanel>
                        </Border>

                        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.ErrorBackground}" BorderBrush="{StaticResource Brush.Border}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Banner}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BannerMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding DismissBannerCommand}"
                                        AutomationProperties.Name="Dismiss content message" Content="Dismiss" />
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap"
                                           Text="{Binding BannerMessage}" AutomationProperties.AutomationId="ContentBanner" />
                            </DockPanel>
                        </Border>

                        <!-- Undo after Move to Trash: shown only in the visit that produced it (the view model withdraws it otherwise). -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource Banner}" Background="{StaticResource Brush.WarningBackground}" BorderBrush="{StaticResource Brush.Border}"
                                Visibility="{Binding HasUndo, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Trash notice">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding DismissUndoCommand}"
                                        AutomationProperties.Name="Dismiss trash notice" Content="Dismiss" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding UndoCommand}"
                                        AutomationProperties.Name="Undo move to Trash" Content="Undo" FontWeight="SemiBold" />
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding UndoMessage}" AutomationProperties.AutomationId="UndoMessage" />
                            </DockPanel>
                        </Border>

                        <!-- List (fills) above the read-only Note preview (only for a selected Note, at most 40 % of this area). -->
                        <Grid x:Name="ContentArea">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        <!-- The Project's Trash replaces the listing while open. Restore returns an entry to the container it came from. -->
                        <DockPanel x:Name="TrashPanel" Grid.RowSpan="2" DataContext="{Binding Trash}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.Name="Trash">
                            <DockPanel DockPanel.Dock="Top" Margin="0,4,0,4">
                                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding DataContext.CloseTrashCommand, ElementName=ContentArea}"
                                        AutomationProperties.Name="Back to content" ToolTip="Back to the folder that was shown">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Back}" />
                                        <TextBlock Margin="6,0,0,0" Text="Back" />
                                    </StackPanel>
                                </Button>
                                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding RestoreCommand}" AutomationProperties.Name="Restore"
                                        ToolTip="Restore the selected entry to the folder it came from (Enter)" Content="Restore" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Title}" AutomationProperties.AutomationId="TrashTitle" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding Notice}" AutomationProperties.AutomationId="TrashNotice"
                                       Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldHint}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="Items in the Trash are kept until you restore them. Nothing on disk was moved or deleted." />
                            <Grid>
                                <ListView x:Name="TrashList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" BorderThickness="0" Background="Transparent"
                                          AutomationProperties.Name="Trash entries" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          PreviewKeyDown="TrashList_PreviewKeyDown">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource ListRow}">
                                            <Setter Property="Padding" Value="8,5" />
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TrashEntryViewModel}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="2*" MinWidth="80" />
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <Image x:Name="Glyph" VerticalAlignment="Center" Style="{StaticResource IconImage}" Source="{StaticResource Img.Folder}" />
                                                <TextBlock Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                <TextBlock Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}"
                                                           Text="{Binding FromText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FromText}" />
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}" Text="{Binding ItemsText}" />
                                                <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}" Text="{Binding TrashedAtText}" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsLink}" Value="True">
                                                    <Setter TargetName="Glyph" Property="Source" Value="{StaticResource Img.Link}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                    <Setter TargetName="Glyph" Property="Source" Value="{StaticResource Img.Note}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <ListView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Restore" InputGestureText="Enter" Command="{Binding RestoreCommand}" />
                                        </ContextMenu>
                                    </ListView.ContextMenu>
                                </ListView>
                                <TextBlock Style="{StaticResource EmptyState}" Text="The Trash is empty." Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                                           AutomationProperties.AutomationId="TrashEmpty" />
                                <TextBlock Style="{StaticResource EmptyState}" Text="Loading the Trash…" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Style="{StaticResource EmptyState}" Foreground="{StaticResource Brush.Error}" Text="{Binding LoadError}"
                                           Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsed}}" />
                            </Grid>
                        </DockPanel>
                        <Grid Visibility="{Binding IsTrashOpen, Converter={StaticResource InverseBoolToVisibility}}">
                            <ListView x:Name="ContentList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                      BorderThickness="0" Background="Transparent" AutomationProperties.Name="Project content"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"
                                      MouseDoubleClick="ContentList_MouseDoubleClick" PreviewKeyDown="ContentList_PreviewKeyDown"
                                      SelectionChanged="ContentList_SelectionChanged">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource ListRow}">
                                        <Setter Property="Padding" Value="8,5" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ProjectContentItemViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="2*" MinWidth="80" />
                                                <ColumnDefinition Width="3*" />
                                                <!-- Fixed width keeps the Target column aligned across rows (each row is its own Grid). -->
                                                <ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>
                                            <Image x:Name="Glyph" VerticalAlignment="Center" Style="{StaticResource IconImage}" Source="{StaticResource Img.Folder}" />
                                            <TextBlock Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}"
                                                       Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}" />
                                            <TextBlock x:Name="Status" Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"
                                                       AutomationProperties.AutomationId="LinkStatus" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding KindText}" Value="Web">
                                                <Setter TargetName="Glyph" Property="Source" Value="{StaticResource Img.WebLink}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding KindText}" Value="File">
                                                <Setter TargetName="Glyph" Property="Source" Value="{StaticResource Img.FileLink}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding KindText}" Value="Folder link">
                                                <Setter TargetName="Glyph" Property="Source" Value="{StaticResource Img.FolderLink}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding KindText}" Value="Note">
                                                <Setter TargetName="Glyph" Property="Source" Value="{StaticResource Img.Note}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStatusUnverified}" Value="True">
                                                <Setter TargetName="Status" Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStatusProblem}" Value="True">
                                                <Setter TargetName="Status" Property="Foreground" Value="{StaticResource Brush.Error}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open" InputGestureText="Enter" Command="{Binding OpenCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Open}" /></MenuItem.Icon></MenuItem>
                                        <MenuItem Header="Edit…" InputGestureText="F2" Command="{Binding EditCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Edit}" /></MenuItem.Icon></MenuItem>
                                        <MenuItem Header="Move to…" Command="{Binding MoveCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Move}" /></MenuItem.Icon></MenuItem>
                                        <MenuItem Header="Move to Trash" InputGestureText="Del" Command="{Binding MoveToTrashCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Trash}" /></MenuItem.Icon></MenuItem>
                                        <MenuItem Header="Check" Command="{Binding CheckCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Check}" /></MenuItem.Icon></MenuItem>
                                        <Separator />
                                        <MenuItem Header="New Folder…" Command="{Binding NewFolderCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.FolderAdd}" /></MenuItem.Icon></MenuItem>
                                        <MenuItem Header="New Link…" Command="{Binding NewLinkCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.LinkAdd}" /></MenuItem.Icon></MenuItem>
                                        <MenuItem Header="New Note…" Command="{Binding NewNoteCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.NoteAdd}" /></MenuItem.Icon></MenuItem>
                                        <Separator />
                                        <MenuItem Header="Check all" Command="{Binding CheckAllCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.CheckAll}" /></MenuItem.Icon></MenuItem>
                                        <MenuItem Header="Stop checking" Command="{Binding StopCheckingCommand}"><MenuItem.Icon><Image Style="{StaticResource IconImage}" Source="{StaticResource Img.Stop}" /></MenuItem.Icon></MenuItem>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>

                            <TextBlock Style="{StaticResource EmptyState}" Text="This folder is empty. Add a folder, link or note."
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ContentEmpty" />
                            <TextBlock Style="{StaticResource EmptyState}" Text="Loading content…"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LoadError}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding LoadError}" AutomationProperties.AutomationId="ContentLoadError" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Center" Content="Retry" Command="{Binding RetryCommand}" AutomationProperties.Name="Retry loading content" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ContainerMessage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Foreground="{StaticResource Brush.MutedText}" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding ContainerMessage}" AutomationProperties.AutomationId="ContentContainerMessage" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Center" Content="Go to project root" Command="{Binding GoUpCommand}"
                                        Visibility="{Binding IsFolderMissing, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Go to project root" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,0"
                                MaxHeight="{Binding ActualHeight, ElementName=ContentArea, Converter={StaticResource PreviewMaxHeight}}"
                                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Note preview">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Button DockPanel.Dock="Right" Content="Edit…" Command="{Binding EditCommand}" AutomationProperties.Name="Edit note" />
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding PreviewNote.Title}" AutomationProperties.AutomationId="PreviewTitle" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{Binding PreviewUpdatedText}" AutomationProperties.AutomationId="PreviewUpdated" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldHint}" Text="Loading note…"
                                           Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Brush.MutedText}" TextWrapping="Wrap" Text="{Binding PreviewMessage}"
                                           AutomationProperties.AutomationId="PreviewMessage" />
                                <TextBox Margin="0,6,0,0" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                         Text="{Binding PreviewNote.Content, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False"
                                         AutomationProperties.Name="Note preview text" />
                            </DockPanel>
                        </Border>
                        </Grid>
                    </DockPanel>

                        <!--
                            Phase 13A Info drawer: right of Content (300 px); below 640 px pane width an overlay sheet over Content.
                            It shows the CURRENT selection (bindings follow SelectedProject / SelectedNode); Esc or ✕ closes it.
                        -->
                        <Border x:Name="InfoDrawer" Grid.Row="1" Width="300" Margin="0,0,20,12" Padding="14,10"
                                CornerRadius="10" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.ControlBorder}" BorderThickness="1"
                                AutomationProperties.Name="Info" AutomationProperties.AutomationId="InfoDrawer"
                                IsKeyboardFocusWithinChanged="InfoDrawer_IsKeyboardFocusWithinChanged">
                            <Border.InputBindings>
                                <KeyBinding Key="Escape" Command="{Binding CloseInfoCommand}" />
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Grid.Column" Value="1" />
                                    <Setter Property="Grid.ColumnSpan" Value="1" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInfoOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <!-- Narrow: an overlay sheet over Content instead of narrowing it. -->
                                        <DataTrigger Binding="{Binding ActualWidth, ElementName=SelectionPane, Converter={StaticResource NarrowerThanInfoDrawer}}" Value="True">
                                            <Setter Property="Grid.Column" Value="0" />
                                            <Setter Property="Grid.ColumnSpan" Value="2" />
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Panel.ZIndex" Value="10" />
                                            <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button x:Name="InfoCloseButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Padding="6,2"
                                            Command="{Binding CloseInfoCommand}" AutomationProperties.Name="Close info" ToolTip="Close (Esc)">
                                        <Image Style="{StaticResource IconImage}" Width="12" Height="12" Source="{StaticResource Img.Dismiss}" />
                                    </Button>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Text="Info" />
                                </DockPanel>

                                <!-- Project -->
                                <Grid DockPanel.Dock="Top" Visibility="{Binding SelectedProject, Converter={StaticResource NullToCollapsed}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Margin="0,0,12,4" Foreground="{StaticResource Brush.MutedText}" Text="Owner" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" TextWrapping="Wrap" Text="{Binding SelectedProject.Owner, TargetNullValue=—}"
                                               AutomationProperties.AutomationId="SelectedProjectOwner" />
                                    <TextBlock Grid.Row="1" Margin="0,0,12,4" Foreground="{StaticResource Brush.MutedText}" Text="Project manager" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" TextWrapping="Wrap" Text="{Binding SelectedProject.ProjectManager, TargetNullValue=—}"
                                               AutomationProperties.AutomationId="SelectedProjectManager" />
                                    <TextBlock Grid.Row="2" Margin="0,0,12,4" Foreground="{StaticResource Brush.MutedText}" Text="Location" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" TextWrapping="Wrap" Text="{Binding SelectedLocation}"
                                               AutomationProperties.AutomationId="InfoLocation" />
                                    <TextBlock Grid.Row="3" Margin="0,0,12,4" Foreground="{StaticResource Brush.MutedText}" Text="Status" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" Text="{Binding SelectedProjectStatus}" AutomationProperties.AutomationId="InfoStatus" />
                                    <TextBlock Grid.Row="4" Margin="0,0,12,4" Foreground="{StaticResource Brush.MutedText}" Text="Created" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,4" Text="{Binding SelectedProject.CreatedAt.LocalDateTime, StringFormat='yyyy-MM-dd HH:mm'}" />
                                    <TextBlock Grid.Row="5" Margin="0,0,12,4" Foreground="{StaticResource Brush.MutedText}" Text="Updated" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,0,0,4" Text="{Binding SelectedProject.UpdatedAt.LocalDateTime, StringFormat='yyyy-MM-dd HH:mm'}" />
                                </Grid>
                                <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,10,0,0" Content="Edit…" Command="{Binding EditProjectCommand}"
                                        AutomationProperties.Name="Edit Project (info)" Visibility="{Binding SelectedProject, Converter={StaticResource NullToCollapsed}}" />
                                <DockPanel Visibility="{Binding SelectedProject, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock DockPanel.Dock="Top" Margin="0,6,0,2" Foreground="{StaticResource Brush.MutedText}" Text="Description" />
                                    <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" Text="{Binding SelectedProject.Description, Mode=OneWay, TargetNullValue=—}"
                                             AutomationProperties.Name="Project description" AutomationProperties.AutomationId="SelectedProjectDescription" />
                                </DockPanel>

                                <!-- Folder -->
                                <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsFolderSelected, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Foreground="{StaticResource Brush.MutedText}" Text="Location" />
                                    <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding SelectedNode.Path}" AutomationProperties.AutomationId="InfoFolderPath" />
                                    <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="InfoFolderCounts"
                                               Visibility="{Binding SelectedFolderInfo, Converter={StaticResource NullToCollapsed}}">
                                        <Run Text="{Binding SelectedFolderInfo.ActiveChildren, Mode=OneWay}" /><Run Text=" visible items · " /><Run Text="{Binding SelectedFolderInfo.ArchivedChildren, Mode=OneWay}" /><Run Text=" archived · " /><Run Text="{Binding SelectedFolderInfo.TrashedChildren, Mode=OneWay}" /><Run Text=" in the Trash" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource FieldHint}" Text="Folders are WorkHub references only; nothing on disk belongs to them." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
