<Window x:Class="WorkHub.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WorkHub.Presentation.ViewModels;assembly=WorkHub.Presentation"
        xmlns:repo="clr-namespace:WorkHub.Core.Repositories;assembly=WorkHub.Core"
        xmlns:views="clr-namespace:WorkHub.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="WorkHub"
        Width="1100" Height="720" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Banner" TargetType="Border">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <views:DepthToIndentConverter x:Key="WorkspaceIndent" Indent="18" />
        <views:FractionConverter x:Key="PreviewMaxHeight" Fraction="0.4" />

        <!-- Workspace tree chevron (replaces the default triangle). -->
        <Style x:Key="WorkspaceTreeExpander" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{StaticResource Brush.MutedText}" Text="&#xE76C;" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Workspace tree row: one full-width Border per node (hover / selected / selected-without-focus, same colors and
            left accent as the Repository ListRow). The indent is applied INSIDE the row (from the node's Depth), and
            children are rendered full-width below it, so every row highlights across the whole catalog width.
            BasedOn keeps the default style's virtualization settings for nested items.
        -->
        <Style x:Key="WorkspaceTreeItem" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,3,8,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Row" Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <Grid Margin="{Binding Depth, Converter={StaticResource WorkspaceIndent}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Style="{StaticResource WorkspaceTreeExpander}" ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Hover}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.SelectedInactive}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Selected}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="WorkHub" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.MutedText}" Text="{Binding StatusText}" />
                <TextBlock DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Warning}" AutomationProperties.AutomationId="CustomDataRoot"
                           Text="{Binding CustomDataRoot, StringFormat=Test data root: {0}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CustomDataRoot}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" ToolTip="Settings" AutomationProperties.Name="Settings"
                        Command="{Binding Repository.OpenSettingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                        <TextBlock Margin="6,0,0,0" Text="Settings" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- Startup error -->
        <Border Grid.Row="1" Background="{StaticResource Brush.ErrorBackground}" BorderBrush="{StaticResource Brush.Border}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Banner}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
        </Border>

        <!-- Non-fatal startup warning -->
        <Border Grid.Row="2" Background="{StaticResource Brush.WarningBackground}" BorderBrush="{StaticResource Brush.Border}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Banner}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WarningMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Foreground="{StaticResource Brush.Warning}" TextWrapping="Wrap" Text="{Binding WarningMessage}" />
        </Border>

        <TabControl x:Name="PrimaryTabs" Grid.Row="3" Margin="12" IsEnabled="{Binding IsReady}" Padding="0">
            <TabItem x:Name="RepositoryTab" Header="Repository" Padding="16,4">
                <Grid DataContext="{Binding Navigation}" Background="{StaticResource Brush.Surface}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: the five fixed Repository groups, then the user-defined Owner groups. One active selection. -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="REPOSITORY" />
                        <ListBox x:Name="CategoryList" DockPanel.Dock="Top" BorderThickness="0" Background="Transparent"
                                 ItemsSource="{Binding Repository.Categories}" SelectedItem="{Binding SelectedCategory}"
                                 AutomationProperties.Name="Repository groups">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RepositoryCategoryViewModel}">
                                    <DockPanel Margin="4,3">
                                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="10"
                                                   Foreground="{StaticResource Brush.MutedText}" VerticalAlignment="Center"
                                                   Text="{Binding VersionControl}" />
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border DockPanel.Dock="Top" Margin="12,14,12,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border}" />
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,6,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Padding="6,2" Margin="0,8,0,0"
                                    ToolTip="Add Owner group" AutomationProperties.Name="Add Owner group" Command="{Binding Owner.AddGroupCommand}">
                                <TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xE710;" />
                            </Button>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="OWNER" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="12,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.MutedText}" Text="No Owner groups yet. Use + to add one.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOwnerGroups}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox x:Name="OwnerGroupList" BorderThickness="0" Background="Transparent"
                                 ItemsSource="{Binding Owner.Groups}" SelectedItem="{Binding Owner.SelectedGroup}"
                                 AutomationProperties.Name="Owner groups"
                                 VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OwnerGroupViewModel}">
                                    <TextBlock Margin="4,3" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.InputBindings>
                                <KeyBinding Key="F2" Command="{Binding Owner.RenameGroupCommand}" />
                                <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding Owner.MoveGroupUpCommand}" />
                                <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding Owner.MoveGroupDownCommand}" />
                            </ListBox.InputBindings>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Add Group…" Command="{Binding Owner.AddGroupCommand}" />
                                    <MenuItem Header="Rename…" InputGestureText="F2" Command="{Binding Owner.RenameGroupCommand}" />
                                    <Separator />
                                    <MenuItem Header="Move Up" InputGestureText="Alt+Up" Command="{Binding Owner.MoveGroupUpCommand}" />
                                    <MenuItem Header="Move Down" InputGestureText="Alt+Down" Command="{Binding Owner.MoveGroupDownCommand}" />
                                    <Separator />
                                    <MenuItem Header="Delete Group…" Command="{Binding Owner.DeleteGroupCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="{StaticResource Brush.Border}" Focusable="False" />

                    <!-- Right (Owner group selected): launcher list -->
                    <DockPanel Grid.Column="2" DataContext="{Binding Owner}"
                               Visibility="{Binding DataContext.IsOwnerActive, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BoolToVisibility}}">
                        <Grid DockPanel.Dock="Top" Margin="16,8,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding SelectedGroup.Name}" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Bottom" Foreground="{StaticResource Brush.MutedText}" Text="{Binding CountText}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource ToolButton}" Command="{Binding AddItemCommand}" ToolTip="Add a launcher" AutomationProperties.Name="Add Item">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE710;" />
                                    <TextBlock Margin="6,0,0,0" Text="Add Item" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OwnerMoreButton" Grid.Column="3" Style="{StaticResource ToolButton}" ToolTip="More" AutomationProperties.Name="Owner more" Click="OwnerMoreButton_Click">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename Group…" Command="{Binding RenameGroupCommand}" />
                                        <MenuItem Header="Move Group Up" Command="{Binding MoveGroupUpCommand}" />
                                        <MenuItem Header="Move Group Down" Command="{Binding MoveGroupDownCommand}" />
                                        <Separator />
                                        <MenuItem Header="Add Group…" Command="{Binding AddGroupCommand}" />
                                        <MenuItem Header="Delete Group…" Command="{Binding DeleteGroupCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>

                        <!-- Open failure (missing target etc.) with a direct Edit action. -->
                        <Border DockPanel.Dock="Top" Margin="16,0,16,8" Padding="12,8" CornerRadius="4" Background="{StaticResource Brush.WarningBackground}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BannerMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss owner message" Command="{Binding DismissBannerCommand}">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE711;" />
                                </Button>
                                <Button DockPanel.Dock="Right" Margin="8,0" Content="Edit" AutomationProperties.Name="Edit launcher" Command="{Binding EditFromBannerCommand}"
                                        Visibility="{Binding BannerCanEdit, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}" Text="{Binding BannerMessage}"
                                               AutomationProperties.AutomationId="OwnerBanner" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.MutedText}"
                                               Text="{Binding BannerTarget, StringFormat=Target: {0}}" AutomationProperties.AutomationId="OwnerBannerTarget">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BannerTarget}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border}" Padding="14,0,12,4">
                            <Grid TextElement.Foreground="{StaticResource Brush.MutedText}" TextElement.FontSize="11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Name" />
                                <TextBlock Grid.Column="1" Text="Type" />
                            </Grid>
                        </Border>

                        <Grid>
                            <ListView x:Name="OwnerItemList" BorderThickness="0" Background="Transparent"
                                      ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" SelectionMode="Single"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.Name="Launchers" MouseDoubleClick="OwnerItemList_MouseDoubleClick">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource ListRow}">
                                        <Setter Property="AutomationProperties.Name">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="{}{0} ({1})">
                                                    <Binding Path="Name" />
                                                    <Binding Path="ActionType" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="ToolTip" Value="{Binding Target}" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding OpenItemCommand}" />
                                    <KeyBinding Key="F2" Command="{Binding EditItemCommand}" />
                                    <KeyBinding Key="Delete" Command="{Binding DeleteItemCommand}" />
                                    <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding MoveItemUpCommand}" />
                                    <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding MoveItemDownCommand}" />
                                </ListView.InputBindings>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open" InputGestureText="Enter" FontWeight="SemiBold" Command="{Binding OpenItemCommand}" />
                                        <MenuItem Header="Copy target" Command="{Binding CopyTargetCommand}" />
                                        <Separator />
                                        <MenuItem Header="Edit…" InputGestureText="F2" Command="{Binding EditItemCommand}" />
                                        <MenuItem Header="Move to…" Command="{Binding MoveItemToGroupCommand}" />
                                        <MenuItem Header="Move Up" InputGestureText="Alt+Up" Command="{Binding MoveItemUpCommand}" />
                                        <MenuItem Header="Move Down" InputGestureText="Alt+Down" Command="{Binding MoveItemDownCommand}" />
                                        <Separator />
                                        <MenuItem Header="Delete…" InputGestureText="Del" Command="{Binding DeleteItemCommand}" />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding ActionType}" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Style="{StaticResource EmptyState}" Text="{Binding EmptyStateText}"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DockPanel>

                    <!-- Right (fixed Repository group selected): toolbar, banner, System list -->
                    <DockPanel Grid.Column="2" DataContext="{Binding Repository}"
                               Visibility="{Binding DataContext.IsRepositoryActive, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BoolToVisibility}}">
                        <Grid DockPanel.Dock="Top" Margin="16,8,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding SelectedCategory.DisplayName}" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Bottom" Foreground="{StaticResource Brush.MutedText}" Text="{Binding CountText}" />
                            </StackPanel>

                            <Grid Grid.Column="2" Width="240" Margin="0,0,4,0"
                                  Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Search systems" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                                <TextBlock Margin="7,0" IsHitTestVisible="False" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.MutedText}" Text="Search code or name…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Button Grid.Column="3" Style="{StaticResource ToolButton}" ToolTip="Search (Ctrl+F)" AutomationProperties.Name="Search" Click="SearchButton_Click">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" />
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource ToolButton}" Command="{Binding AddSystemCommand}" ToolTip="Add a System" AutomationProperties.Name="Add System">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE710;" />
                                    <TextBlock Margin="6,0,0,0" Text="Add System" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="MoreButton" Grid.Column="5" Style="{StaticResource ToolButton}" ToolTip="More" AutomationProperties.Name="More" Click="MoreButton_Click">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Show inactive systems" IsCheckable="True" IsChecked="{Binding ShowInactive}" />
                                        <Separator />
                                        <MenuItem Header="Repository settings…" Command="{Binding OpenSettingsCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>

                        <!-- Repository warning (e.g. missing TortoiseSVN / host) with a direct fix action. -->
                        <Border DockPanel.Dock="Top" Margin="16,0,16,8" Padding="12,8" CornerRadius="4"
                                Background="{StaticResource Brush.WarningBackground}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BannerMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Command="{Binding DismissBannerCommand}">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE711;" />
                                </Button>
                                <Button DockPanel.Dock="Right" Margin="8,0" Content="Fix Settings" Command="{Binding FixSettingsCommand}"
                                        Visibility="{Binding BannerCanFixSettings, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}" Text="{Binding BannerMessage}" AutomationProperties.AutomationId="RepositoryBanner" />
                            </DockPanel>
                        </Border>

                        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border}" Padding="14,0,12,4">
                            <Grid TextElement.Foreground="{StaticResource Brush.MutedText}" TextElement.FontSize="11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="System Code" />
                                <TextBlock Grid.Column="1" Text="System Name" />
                            </Grid>
                        </Border>

                        <Grid>
                            <ListView x:Name="SystemList" BorderThickness="0" Background="Transparent"
                                      ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                      SelectionMode="Single"
                                      
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.Name="Systems"
                                      MouseDoubleClick="SystemList_MouseDoubleClick">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource ListRow}">
                                        <Setter Property="AutomationProperties.Name">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="SystemCode" />
                                                    <Binding Path="SystemName" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding OpenSelectedCommand}" />
                                    <KeyBinding Key="F2" Command="{Binding EditSystemCommand}" />
                                </ListView.InputBindings>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open" InputGestureText="Enter" FontWeight="SemiBold" Command="{Binding OpenSelectedCommand}" />
                                        <MenuItem Header="Copy target" Command="{Binding CopyTargetCommand}" />
                                        <Separator />
                                        <MenuItem Header="Edit…" InputGestureText="F2" Command="{Binding EditSystemCommand}" />
                                        <MenuItem Command="{Binding ToggleActiveCommand}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="Deactivate" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedIsActive}" Value="False">
                                                            <Setter Property="Header" Value="Reactivate" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Delete permanently…" Command="{Binding DeletePermanentlyCommand}" />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type repo:SystemListItem}">
                                        <Grid x:Name="Row">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SystemCode}" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding SystemName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Border x:Name="CustomTag" Style="{StaticResource Tag}" Visibility="Collapsed" ToolTip="{Binding CustomTarget}">
                                                    <TextBlock FontSize="10" Text="custom target" Foreground="{StaticResource Brush.MutedText}" />
                                                </Border>
                                                <Border x:Name="InactiveTag" Style="{StaticResource Tag}" Visibility="Collapsed">
                                                    <TextBlock FontSize="10" Text="inactive" Foreground="{StaticResource Brush.MutedText}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasCustomTarget}" Value="True">
                                                <Setter TargetName="CustomTag" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter TargetName="InactiveTag" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Style="{StaticResource EmptyState}" Text="{Binding EmptyStateText}"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="WorkspaceTab" Header="Workspace" Padding="16,4" IsSelected="{Binding Workspace.IsTabSelected, Mode=TwoWay}">
                <Grid Background="{StaticResource Brush.Surface}" DataContext="{Binding Workspace}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" MinWidth="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Workspace banner (errors that did not change anything) -->
                    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource Brush.ErrorBackground}" BorderBrush="{StaticResource Brush.Border}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Banner}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BannerMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding DismissBannerCommand}"
                                    AutomationProperties.Name="Dismiss workspace message" Content="Dismiss" />
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap"
                                       Text="{Binding BannerMessage}" AutomationProperties.AutomationId="WorkspaceBanner" />
                        </DockPanel>
                    </Border>

                    <!-- Tree -->
                    <DockPanel Grid.Row="1" Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,4">
                            <Button Style="{StaticResource ToolButton}" Command="{Binding NewFolderCommand}" AutomationProperties.Name="New Folder" ToolTip="New folder (a WorkHub reference only)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8F4;" />
                                    <TextBlock Margin="6,0,0,0" Text="Folder" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding NewProjectCommand}" AutomationProperties.Name="New Project" ToolTip="New project">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" />
                                    <TextBlock Margin="6,0,0,0" Text="Project" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding RenameCommand}" AutomationProperties.Name="Rename" ToolTip="Rename (F2)">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8AC;" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding MoveCommand}" AutomationProperties.Name="Move to" ToolTip="Move to…">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8DE;" />
                            </Button>
                        </StackPanel>

                        <Grid>
                            <TreeView x:Name="WorkspaceTree" BorderThickness="0" Background="Transparent" Padding="0"
                                      ItemsSource="{Binding Roots}" AutomationProperties.Name="Workspace tree"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      PreviewMouseRightButtonDown="WorkspaceTree_PreviewMouseRightButtonDown">
                                <TreeView.InputBindings>
                                    <KeyBinding Key="F2" Command="{Binding RenameCommand}" />
                                </TreeView.InputBindings>
                                <TreeView.ItemContainerStyle>
                                    <StaticResource ResourceKey="WorkspaceTreeItem" />
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:WorkspaceNodeViewModel}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="{StaticResource Brush.Warning}" />
                                            <TextBlock x:Name="Label" Margin="6,1,4,1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <HierarchicalDataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsProject}" Value="True">
                                                <Setter TargetName="Glyph" Property="Text" Value="&#xE8A5;" />
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.MutedText}" />
                                            </DataTrigger>
                                        </HierarchicalDataTemplate.Triggers>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="New Folder…" Command="{Binding NewFolderCommand}" />
                                        <MenuItem Header="New Project…" Command="{Binding NewProjectCommand}" />
                                        <Separator />
                                        <MenuItem Header="Rename…" InputGestureText="F2" Command="{Binding RenameCommand}" />
                                        <MenuItem Header="Edit Project…" Command="{Binding EditProjectCommand}" />
                                        <MenuItem Header="Move to…" Command="{Binding MoveCommand}" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                            </TreeView>

                            <TextBlock Style="{StaticResource EmptyState}" Text="Workspace is empty. Create a folder or project."
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource EmptyState}" Text="Loading…"
                                       Visibility="{Binding IsLoadingRoots, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RootLoadError}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding RootLoadError}" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Center" Content="Retry" Command="{Binding RetryLoadCommand}" AutomationProperties.Name="Retry loading Workspace" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="{StaticResource Brush.Border}" />

                    <!--
                        Details (top, scrolls on its own) and the selected Project's content (fills the rest). The content
                        list is not inside a ScrollViewer, so its own VirtualizingStackPanel keeps virtualizing.
                    -->
                    <Grid Grid.Row="1" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <!-- Without Project content (Folder or nothing selected) the details take the whole pane. -->
                            <RowDefinition>
                                <RowDefinition.Style>
                                    <Style TargetType="RowDefinition">
                                        <Setter Property="Height" Value="Auto" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedContent}" Value="{x:Null}">
                                                <Setter Property="Height" Value="*" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RowDefinition.Style>
                            </RowDefinition>
                            <RowDefinition>
                                <RowDefinition.Style>
                                    <Style TargetType="RowDefinition">
                                        <Setter Property="Height" Value="*" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedContent}" Value="{x:Null}">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RowDefinition.Style>
                            </RowDefinition>
                        </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="MaxHeight" Value="300" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedContent}" Value="{x:Null}">
                                        <Setter Property="MaxHeight" Value="Infinity" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel Margin="20,14">
                            <TextBlock HorizontalAlignment="Left" Margin="0" Text="Select a folder or project.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyState}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SelectedNode}" Value="{x:Null}" />
                                                    <Condition Binding="{Binding IsActivated}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Folder -->
                            <StackPanel Visibility="{Binding IsFolderSelected, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource SectionHeader}" Margin="0" Text="FOLDER" />
                                <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding SelectedNode.Name}"
                                           AutomationProperties.AutomationId="SelectedFolderName" />
                                <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Text="{Binding SelectedNode.Path}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Rename…" Command="{Binding RenameCommand}" />
                                    <Button Margin="8,0,0,0" Content="Move to…" Command="{Binding MoveCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Project -->
                            <TextBlock Style="{StaticResource FieldHint}" Text="Loading project…"
                                       Visibility="{Binding IsLoadingDetails, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource FieldError}" FontSize="12" Text="{Binding DetailsMessage}" AutomationProperties.AutomationId="DetailsMessage" />
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource SectionHeader}" Margin="0" Text="PROJECT" />
                                <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding SelectedProject.Name}"
                                           AutomationProperties.AutomationId="SelectedProjectName" />
                                <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Text="{Binding SelectedNode.Path}" />
                                <Border Style="{StaticResource Tag}" HorizontalAlignment="Left" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding SelectedProjectStatus}" AutomationProperties.AutomationId="SelectedProjectStatus" />
                                </Border>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Foreground="{StaticResource Brush.MutedText}" Text="Owner" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Text="{Binding SelectedProject.Owner, TargetNullValue=—}" AutomationProperties.AutomationId="SelectedProjectOwner" />
                                    <TextBlock Grid.Row="1" Margin="0,4,0,0" Foreground="{StaticResource Brush.MutedText}" Text="Project manager" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding SelectedProject.ProjectManager, TargetNullValue=—}" AutomationProperties.AutomationId="SelectedProjectManager" />
                                    <TextBlock Grid.Row="2" Margin="0,4,0,0" Foreground="{StaticResource Brush.MutedText}" Text="Created" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" Text="{Binding SelectedProject.CreatedAt.LocalDateTime, StringFormat='yyyy-MM-dd HH:mm'}" />
                                    <TextBlock Grid.Row="3" Margin="0,4,0,0" Foreground="{StaticResource Brush.MutedText}" Text="Updated" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" Text="{Binding SelectedProject.UpdatedAt.LocalDateTime, StringFormat='yyyy-MM-dd HH:mm'}" />
                                </Grid>

                                <TextBlock Margin="0,12,0,2" Foreground="{StaticResource Brush.MutedText}" Text="Description" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding SelectedProject.Description, TargetNullValue=—}" AutomationProperties.AutomationId="SelectedProjectDescription" />

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Edit…" Style="{StaticResource PrimaryButton}" Command="{Binding EditProjectCommand}" AutomationProperties.Name="Edit Project" />
                                    <Button Margin="8,0,0,0" Content="Move to…" Command="{Binding MoveCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Project content: ProjectFolders and Links of one container at a time (never shown in the tree). -->
                    <DockPanel Grid.Row="1" Margin="20,0,20,12" DataContext="{Binding SelectedContent}">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Margin="0" Text="CONTENT" />
                                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Breadcrumb}" AutomationProperties.Name="Content location"
                                              Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ContentCrumbViewModel}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Separator" Margin="2,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}" Text="›" />
                                                <Button Style="{StaticResource ToolButton}" Padding="4,2" Content="{Binding Name}" Command="{Binding NavigateCommand}"
                                                        AutomationProperties.Name="{Binding Name}" ToolTip="Go to this folder" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                    <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,4">
                            <Button Style="{StaticResource ToolButton}" Command="{Binding GoUpCommand}" AutomationProperties.Name="Up one level" ToolTip="Up one level (Backspace)">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding NewFolderCommand}" AutomationProperties.Name="New content folder" ToolTip="New folder (a WorkHub reference only)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8F4;" />
                                    <TextBlock Margin="6,0,0,0" Text="Folder" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding NewLinkCommand}" AutomationProperties.Name="New link" ToolTip="New link to a folder, file or web page">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" />
                                    <TextBlock Margin="6,0,0,0" Text="Link" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding NewNoteCommand}" AutomationProperties.Name="New note" ToolTip="New plain-text note">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70B;" />
                                    <TextBlock Margin="6,0,0,0" Text="Note" />
                                </StackPanel>
                            </Button>
                            <Border Width="1" Margin="6,4" Background="{StaticResource Brush.Border}" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding OpenCommand}" AutomationProperties.Name="Open" ToolTip="Open (Enter)" Content="Open" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding EditCommand}" AutomationProperties.Name="Edit content item" ToolTip="Rename folder / edit link / edit note (F2)" Content="Edit…" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding MoveCommand}" AutomationProperties.Name="Move content item" ToolTip="Move within this project" Content="Move to…" />
                            <Border Width="1" Margin="6,4" Background="{StaticResource Brush.Border}" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding CheckCommand}" AutomationProperties.Name="Check link" ToolTip="Check whether the selected link's folder or file can be found" Content="Check" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding CheckAllCommand}" AutomationProperties.Name="Check all links" ToolTip="Check every link in this folder" Content="Check all" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding StopCheckingCommand}" AutomationProperties.Name="Stop checking" ToolTip="Stop checking" Content="Stop" />
                        </WrapPanel>

                        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.ErrorBackground}" BorderBrush="{StaticResource Brush.Border}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Banner}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BannerMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding DismissBannerCommand}"
                                        AutomationProperties.Name="Dismiss content message" Content="Dismiss" />
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap"
                                           Text="{Binding BannerMessage}" AutomationProperties.AutomationId="ContentBanner" />
                            </DockPanel>
                        </Border>

                        <!-- List (fills) above the read-only Note preview (only for a selected Note, at most 40 % of this area). -->
                        <Grid x:Name="ContentArea">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        <Grid>
                            <ListView x:Name="ContentList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                      BorderThickness="0" Background="Transparent" AutomationProperties.Name="Project content"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"
                                      MouseDoubleClick="ContentList_MouseDoubleClick" PreviewKeyDown="ContentList_PreviewKeyDown">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource ListRow}">
                                        <Setter Property="Padding" Value="8,5" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ProjectContentItemViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="2*" MinWidth="80" />
                                                <ColumnDefinition Width="3*" />
                                                <!-- Fixed width keeps the Target column aligned across rows (each row is its own Grid). -->
                                                <ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="{StaticResource Brush.Warning}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}"
                                                       Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}" />
                                            <TextBlock x:Name="Status" Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource Brush.MutedText}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"
                                                       AutomationProperties.AutomationId="LinkStatus" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding KindText}" Value="Web">
                                                <Setter TargetName="Glyph" Property="Text" Value="&#xE774;" />
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding KindText}" Value="File">
                                                <Setter TargetName="Glyph" Property="Text" Value="&#xE8A5;" />
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding KindText}" Value="Folder link">
                                                <Setter TargetName="Glyph" Property="Text" Value="&#xE838;" />
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding KindText}" Value="Note">
                                                <Setter TargetName="Glyph" Property="Text" Value="&#xE70B;" />
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.MutedText}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStatusUnverified}" Value="True">
                                                <Setter TargetName="Status" Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStatusProblem}" Value="True">
                                                <Setter TargetName="Status" Property="Foreground" Value="{StaticResource Brush.Error}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open" InputGestureText="Enter" Command="{Binding OpenCommand}" />
                                        <MenuItem Header="Edit…" InputGestureText="F2" Command="{Binding EditCommand}" />
                                        <MenuItem Header="Move to…" Command="{Binding MoveCommand}" />
                                        <MenuItem Header="Check" Command="{Binding CheckCommand}" />
                                        <Separator />
                                        <MenuItem Header="New Folder…" Command="{Binding NewFolderCommand}" />
                                        <MenuItem Header="New Link…" Command="{Binding NewLinkCommand}" />
                                        <MenuItem Header="New Note…" Command="{Binding NewNoteCommand}" />
                                        <Separator />
                                        <MenuItem Header="Check all" Command="{Binding CheckAllCommand}" />
                                        <MenuItem Header="Stop checking" Command="{Binding StopCheckingCommand}" />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>

                            <TextBlock Style="{StaticResource EmptyState}" Text="This folder is empty. Add a folder, link or note."
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ContentEmpty" />
                            <TextBlock Style="{StaticResource EmptyState}" Text="Loading content…"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LoadError}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding LoadError}" AutomationProperties.AutomationId="ContentLoadError" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Center" Content="Retry" Command="{Binding RetryCommand}" AutomationProperties.Name="Retry loading content" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ContainerMessage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Foreground="{StaticResource Brush.MutedText}" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding ContainerMessage}" AutomationProperties.AutomationId="ContentContainerMessage" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Center" Content="Go to project root" Command="{Binding GoUpCommand}"
                                        Visibility="{Binding IsFolderMissing, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Go to project root" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,0"
                                MaxHeight="{Binding ActualHeight, ElementName=ContentArea, Converter={StaticResource PreviewMaxHeight}}"
                                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Note preview">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Button DockPanel.Dock="Right" Content="Edit…" Command="{Binding EditCommand}" AutomationProperties.Name="Edit note" />
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding PreviewNote.Title}" AutomationProperties.AutomationId="PreviewTitle" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{Binding PreviewUpdatedText}" AutomationProperties.AutomationId="PreviewUpdated" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldHint}" Text="Loading note…"
                                           Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Brush.MutedText}" TextWrapping="Wrap" Text="{Binding PreviewMessage}"
                                           AutomationProperties.AutomationId="PreviewMessage" />
                                <TextBox Margin="0,6,0,0" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                         Text="{Binding PreviewNote.Content, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False"
                                         AutomationProperties.Name="Note preview text" />
                            </DockPanel>
                        </Border>
                        </Grid>
                    </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
