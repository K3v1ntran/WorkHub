<Window x:Class="WorkHub.App.Views.SystemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WorkHub.Presentation.ViewModels;assembly=WorkHub.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SystemEditorViewModel}"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Surface}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=CodeBox}">

    <DockPanel Margin="20,12,20,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Content="Save" IsDefault="True" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
        </StackPanel>

        <StackPanel>
            <TextBlock Style="{StaticResource FieldError}" FontSize="12" Text="{Binding GeneralError}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="System Code" />
            <TextBox x:Name="CodeBox" FontFamily="Consolas" FontSize="13" MaxLength="100"
                     Text="{Binding SystemCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="System Code" />
            <TextBlock Style="{StaticResource FieldError}" Text="{Binding CodeError}" />
            <TextBlock Style="{StaticResource FieldHint}" Text="Letters A-Z, digits, '.', '_' and '-'. Must be unique (ignoring case)." />
            <TextBlock Style="{StaticResource FieldHint}" Foreground="{StaticResource Brush.Warning}"
                       Visibility="{Binding IsCodeChanged, Converter={StaticResource BoolToVisibility}}"
                       Text="Changing the code changes every generated repository target of this System. Custom targets are not changed." />

            <TextBlock Style="{StaticResource FieldLabel}" Text="System Name" />
            <TextBox MaxLength="200" Text="{Binding SystemName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="System Name" />
            <TextBlock Style="{StaticResource FieldError}" Text="{Binding NameError}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Description (optional)" />
            <TextBox MaxLength="2000" Height="52" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Description" />
            <TextBlock Style="{StaticResource FieldError}" Text="{Binding DescriptionError}" />

            <CheckBox Margin="0,10,0,0" Content="Active" IsChecked="{Binding IsActive}"
                      Visibility="{Binding IsEdit, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,3" Text="Repositories" />
            <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,6"
                       Text="Tick every group this System belongs to. Leave the custom target empty to use host + prefix + code from Settings." />
            <ItemsControl ItemsSource="{Binding Memberships}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MembershipEditorViewModel}">
                        <StackPanel Margin="0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox VerticalAlignment="Center" FontWeight="SemiBold" Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" />
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="Target" FontSize="11" Text="{Binding CustomTarget, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsSelected}" AutomationProperties.Name="{Binding DisplayName, StringFormat=Custom target for {0}}" />
                                    <TextBlock x:Name="Placeholder" Margin="7,0" FontSize="11" IsHitTestVisible="False" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource Brush.MutedText}" Text="{Binding Placeholder}" Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                            <TextBlock Margin="130,2,0,0" Style="{StaticResource FieldError}" Text="{Binding Error}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Target}" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource FieldError}" Text="{Binding MembershipsError}" />
        </StackPanel>
    </DockPanel>
</Window>
