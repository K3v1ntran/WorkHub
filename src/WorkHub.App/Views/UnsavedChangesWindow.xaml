<Window x:Class="WorkHub.App.Views.UnsavedChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Surface}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <DockPanel Margin="20,16,20,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click" AutomationProperties.Name="Save" />
            <Button Margin="8,0,0,0" Content="Don't save" Click="Discard_Click" AutomationProperties.Name="Don't save" />
            <Button Margin="8,0,0,0" Content="Cancel" IsCancel="True" AutomationProperties.Name="Cancel" />
        </StackPanel>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" AutomationProperties.AutomationId="UnsavedMessage" />
    </DockPanel>
</Window>
