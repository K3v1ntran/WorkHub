<Window x:Class="WorkHub.App.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Surface}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <DockPanel Margin="20,16,20,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <!-- Cancel is focused and is the Enter/Esc default, so a stray key press never confirms a destructive action. -->
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True" Click="Cancel_Click" />
            <Button x:Name="ConfirmButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" />
        </StackPanel>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" AutomationProperties.AutomationId="ConfirmMessage" />
    </DockPanel>
</Window>
