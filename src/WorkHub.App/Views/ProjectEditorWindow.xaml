<Window x:Class="WorkHub.App.Views.ProjectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WorkHub.Presentation.ViewModels;assembly=WorkHub.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ProjectEditorViewModel}"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Surface}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <DockPanel Margin="20,12,20,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Content="Save" IsDefault="True" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
        </StackPanel>

        <StackPanel>
            <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,4" Text="{Binding LocationText}" TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource FieldError}" FontSize="12" Text="{Binding GeneralError}" AutomationProperties.AutomationId="GeneralError" />
            <TextBlock Style="{StaticResource FieldHint}" Text="Saving… this window stays open until the change is stored."
                       Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="SavingHint" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Project name" />
                    <TextBox x:Name="NameBox" MaxLength="200" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Project name" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding NameError}" AutomationProperties.AutomationId="NameError" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Status" />
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Status" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding StatusError}" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Owner (optional)" />
                    <TextBox MaxLength="100" Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Owner" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding OwnerError}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Project manager (optional)" />
                    <TextBox MaxLength="100" Text="{Binding ProjectManager, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Project manager" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding ProjectManagerError}" />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Description (optional)" />
            <TextBox MaxLength="4000" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Description" />
            <TextBlock Style="{StaticResource FieldError}" Text="{Binding DescriptionError}" />
            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                       Text="Workspace entries are WorkHub references only. No files or folders are created, moved or renamed." />
        </StackPanel>
    </DockPanel>
</Window>
