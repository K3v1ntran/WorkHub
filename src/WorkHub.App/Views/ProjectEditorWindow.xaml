<Window x:Class="WorkHub.App.Views.ProjectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WorkHub.Presentation.ViewModels;assembly=WorkHub.Presentation"
        xmlns:views="clr-namespace:WorkHub.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ProjectEditorViewModel}"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Surface}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <views:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </Window.Resources>
    <DockPanel Margin="20,12,20,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Content="Save" IsDefault="True" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
        </StackPanel>

        <StackPanel>
            <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,4" Text="{Binding LocationText}" TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource FieldError}" FontSize="12" Text="{Binding GeneralError}" AutomationProperties.AutomationId="GeneralError" />
            <TextBlock Style="{StaticResource FieldHint}" Text="Saving… this window stays open until the change is stored."
                       Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="SavingHint" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Project name" />
                    <TextBox x:Name="NameBox" MaxLength="200" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Project name" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding NameError}" AutomationProperties.AutomationId="NameError" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Status" />
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Status" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding StatusError}" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Owner (optional)" />
                    <TextBox MaxLength="100" Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Owner" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding OwnerError}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Project manager (optional)" />
                    <TextBox MaxLength="100" Text="{Binding ProjectManager, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Project manager" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding ProjectManagerError}" />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Description (optional)" />
            <TextBox MaxLength="4000" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Description" />
            <TextBlock Style="{StaticResource FieldError}" Text="{Binding DescriptionError}" />

            <!-- Phase 17 tags: chips (✕ removes), a box (Enter or comma adds, Backspace in an empty box removes the last chip). -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Tags (optional, up to 20)" />
            <ItemsControl ItemsSource="{Binding Tags}" Focusable="False" AutomationProperties.Name="Tags">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TagChipButton}" Command="{Binding Command}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Remove tag {0}'}" ToolTip="Remove this tag">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Margin="6,0,0,0" Foreground="{StaticResource Brush.MutedText}" Text="✕" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox x:Name="TagBox" MaxLength="200" Text="{Binding TagInput, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanAddTag}"
                     AutomationProperties.Name="New tag" ToolTip="Type a tag, then Enter or comma"
                     PreviewKeyDown="TagBox_PreviewKeyDown" PreviewTextInput="TagBox_PreviewTextInput" />
            <TextBlock x:Name="TagLimitHint" Style="{StaticResource FieldHint}" Text="{Binding TagLimitText}" AutomationProperties.AutomationId="TagLimit"
                       Visibility="{Binding TagLimitText, Converter={StaticResource NullToCollapsed}}" />
            <ItemsControl x:Name="TagSuggestions" ItemsSource="{Binding FilteredSuggestions}" IsEnabled="{Binding CanAddTag}"
                          Focusable="False" Margin="0,4,0,0" AutomationProperties.Name="Tag suggestions">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TagChipButton}" Command="{Binding Command}" Content="{Binding Name}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Add suggested tag {0}'}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource FieldError}" Text="{Binding TagError}" AutomationProperties.AutomationId="TagError" />
            <TextBlock Style="{StaticResource FieldHint}" Text="{Binding TagNote}" AutomationProperties.AutomationId="TagNote"
                       Visibility="{Binding TagNote, Converter={StaticResource NullToCollapsed}}" />
            <!-- Phase 21 R2a: after a Save refused because the tags changed in another window. Save stays disabled until one is chosen. -->
            <StackPanel Visibility="{Binding IsTagConflictPending, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="TagConflict">
                <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Text="{Binding CurrentTagsText}" AutomationProperties.AutomationId="CurrentTags" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Use current tags" Command="{Binding UseCurrentTagsCommand}" AutomationProperties.AutomationId="UseCurrentTags"
                            ToolTip="Replace your tags with the current ones; your other changes are kept" />
                    <Button Content="Keep my tags" Margin="8,0,0,0" Command="{Binding KeepMyTagsCommand}" AutomationProperties.AutomationId="KeepMyTags"
                            ToolTip="Save your tags over the current ones" />
                </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                       Text="Workspace entries are WorkHub references only. No files or folders are created, moved or renamed." />
        </StackPanel>
    </DockPanel>
</Window>
