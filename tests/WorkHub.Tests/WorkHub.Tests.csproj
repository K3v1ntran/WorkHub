<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Legacy import fixture: SystemCode / SystemName master data only (no hosts, URLs or credentials). -->
  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WorkHub.Core\WorkHub.Core.csproj" />
    <ProjectReference Include="..\..\src\WorkHub.Infrastructure\WorkHub.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\WorkHub.Presentation\WorkHub.Presentation.csproj" />
    <!-- Built first; started and killed by the process-crash tests (not referenced as an assembly). -->
    <ProjectReference Include="..\WorkHub.CrashProbe\WorkHub.CrashProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CrashProbePath</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\WorkHub.CrashProbe\bin\$(Configuration)\net10.0\WorkHub.CrashProbe.exe</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
