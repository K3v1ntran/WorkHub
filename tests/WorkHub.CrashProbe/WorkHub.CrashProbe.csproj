  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WorkHub.Core\WorkHub.Core.csproj" />
    <ProjectReference Include="..\..\src\WorkHub.Infrastructure\WorkHub.Infrastructure.csproj" />
  </ItemGroup>

</Project>
